// TSConfig for modules that run in Node.js environment via either transpilation or type-stripping.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    // Most tools use transpilation instead of Node.js's native type-stripping.
    // Bundler mode provides a smoother developer experience.
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // 两个 E2E 配置（`.ts`）import 纯 JS 的 `e2e/config.mjs`：不开它，TS 不把 `.mjs` 收进程序，
    // 直接报 TS7016「找不到声明」（T2 执行期实测）。
    // ⚠️ 实测过「范围放大」的代价：`include` 里的根目录 glob 在**本工程**匹配不到任何 `.js`
    // （没有 `vite.config.js` 这类文件），`e2e/**/*.ts` 也只匹配 `.ts` ⇒ 开它只多收
    // **一个**文件（`e2e/config.mjs`），且 `checkJs` 保持关闭 ⇒ `.mjs` 自身的代码不进门禁。
    "allowJs": true,

    // Include Node.js types and avoid accidentally including other `@types/*` packages.
    "types": ["node"],

    // Disable emitting output during `vue-tsc --build`, which is used for type-checking only.
    "noEmit": true,

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
