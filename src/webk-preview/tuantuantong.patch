+}
+
+function installProfileActivationGuard(order?: OrderProfileOptions) {
+  const guard = (event: Event) => {
+    if(!(event.target instanceof Element)) return;
+    if(event instanceof KeyboardEvent && event.key !== 'Enter' && event.key !== ' ') return;
+    const control = event.target.closest(`${profileTileSelector}:disabled, ${groupProfileAction}`);
+    const member = order?.isOrderGroup() &&
+      event.target.closest<HTMLElement>('#column-right .profile-content a.chatlist-chat[data-peer-id]');
+    const peerId = member && member.dataset.peerId.toPeerId();
+    const fromOrder = peerId && (order.isOrderMember(peerId) || peerId === order.selfId);
+    if(!control && !fromOrder) return;
+
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    if(fromOrder && event.type !== 'mousedown') order.openMemberProfile(peerId);
+  };
+  // Native activation can run on mousedown on touch-capable devices.
+  document.addEventListener('mousedown', guard, true);
+  document.addEventListener('click', guard, true);
+  document.addEventListener('keydown', guard, true);
+}
+
+function removeOrphanSeparators(menu: HTMLElement) {
+  let previousWasSeparator = true;
+  for(const element of Array.from(menu.children)) {
+    if(element.tagName !== 'HR') {
+      previousWasSeparator = false;
+    } else if(previousWasSeparator) {
+      element.remove();
+    } else {
+      previousWasSeparator = true;
+    }
+  }
+  if(menu.lastElementChild?.tagName === 'HR') menu.lastElementChild.remove();
+}
