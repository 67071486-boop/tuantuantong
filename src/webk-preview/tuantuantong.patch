@@ -0,0 +1,241 @@
+import {appendButtonMenuItems, setButtonMenuItemDisabled} from '@components/buttonMenu';
+import {getIconContent} from '@components/icon';
+import contextMenuController from '@helpers/contextMenuController';
+import I18n, {type LangPackKey} from '@lib/langPack';
+import {positionH5ComposeMenu} from './h5ListControls';
+import './previewProfileActions.css';
+
+const hiddenMainItems = new Set<LangPackKey>([
+  'MultiAccount.AddAccount',
