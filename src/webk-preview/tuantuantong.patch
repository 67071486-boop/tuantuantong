diff --git a/src/pages/localChatPreview/orderMediaActions.ts b/src/pages/localChatPreview/orderMediaActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5021b94a8c231b2caa4e510fecaf3c5275faa661
--- /dev/null
+++ b/src/pages/localChatPreview/orderMediaActions.ts
@@ -0,0 +1,194 @@
+import Icon from '@components/icon';
+import type AppMediaViewer from '@components/mediaViewer';
+import I18n from '@lib/langPack';
+import type {ChatMessage, ChatSearchFilters, Contact} from './liveTransport';
+import './orderMediaActions.css';
+
+type OrderSearch = {
+  peerId: PeerId;
+  isOrder: boolean;
+  canPin: boolean;
+  members: Contact[];
+  search: (query: string, before: number | undefined, filters: ChatSearchFilters) => Promise<{messages: ChatMessage[]; has_more: boolean}>;
+  openMessage: (id: number, fromViewer?: boolean) => void;
+};
+
+function dateBound(value: FormDataEntryValue, upper = false) {
+  if(!value) return;
+  const timestamp = Date.parse(value + (upper ? 'T23:59:59' : 'T00:00:00'));
+  if(Number.isFinite(timestamp)) return Math.floor(timestamp / 1000);
+}
+
+function showSearch(context: OrderSearch, initialQuery: string) {
+  const dialog = document.createElement('dialog');
+  dialog.className = 'tt-order-search';
+  dialog.setAttribute('aria-labelledby', 'tt-order-search-title');
+  dialog.innerHTML = `
+    <header><h2 id="tt-order-search-title">搜索会话消息</h2><button type="button" class="btn-icon tt-order-search-close" aria-label="关闭"></button></header>
+    <form>
+      <label>关键词<input type="search" name="query" placeholder="搜索消息内容" maxlength="100"></label>
+      <label>发件人<select name="sender"><option value="">全部成员</option></select></label>
+      <label>开始日期<input type="date" name="from"></label>
+      <label>结束日期<input type="date" name="to"></label>
+      <label class="tt-order-search-image"><input type="checkbox" name="image">只看图片</label>
+      <button type="submit" class="tt-order-search-submit">搜索</button>
+    </form>
+    <p class="tt-order-search-status" role="status"></p>
+    <ul class="tt-order-search-results"></ul>
+    <button type="button" class="tt-order-search-more" hidden>加载更多</button>`;
+  const form = dialog.querySelector('form');
+  const sender = dialog.querySelector('select');
+  const status = dialog.querySelector('p');
+  const results = dialog.querySelector('ul');
+  const more = dialog.querySelector<HTMLButtonElement>('.tt-order-search-more');
+  const close = dialog.querySelector('.tt-order-search-close');
+  const names = new Map(context.members.map(({id, name}) => [id, name]));
+  const dateFormat = new Intl.DateTimeFormat('zh-CN', {month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit'});
+  dialog.querySelector('input').value = initialQuery.slice(0, 100);
+  for(const {id, name} of context.members) sender.append(new Option(name, String(id)));
+  close.append(Icon('close'));
+  close.addEventListener('click', () => dialog.close());
+  dialog.addEventListener('close', () => dialog.remove());
+
+  let cursor: number | undefined;
+  let run = 0;
+  let current: {query: string; filters: ChatSearchFilters};
+
+  async function load(append: boolean) {
+    if(append && (!cursor || !current)) return;
+    const serial = ++run;
+    if(!append) {
+      results.replaceChildren();
+      more.hidden = true;
+      cursor = undefined;
+      const fields = new FormData(form);
+      const query = String(fields.get('query') ?? '').trim();
+      const filters: ChatSearchFilters = {
+        senderId: Number(fields.get('sender')) || undefined,
+        dateFrom: dateBound(fields.get('from')),
+        dateTo: dateBound(fields.get('to'), true),
+        imageOnly: fields.has('image')
+      };
+      if(filters.dateFrom !== undefined && filters.dateTo !== undefined && filters.dateFrom > filters.dateTo) {
+        status.textContent = '结束日期不能早于开始日期';
+        more.disabled = false;
+        return;
+      }
+      if(!query && !Object.values(filters).some((value) => value !== undefined && value !== false)) {
+        status.textContent = '请输入关键词或选择筛选条件';
+        more.disabled = false;
+        return;
+      }
+      current = {query, filters};
+    }
+
+    more.disabled = true;
+    status.textContent = '正在查找消息…';
+    try {
+      const page = await context.search(current.query, cursor, current.filters);
+      if(serial !== run || !dialog.open) return;
+      for(const message of page.messages) {
+        const row = document.createElement('li');
+        const result = document.createElement('button');
+        result.type = 'button';
+        const detail = document.createElement('small');
+        detail.textContent = (names.get(message.sender_id) || '群成员') + ' · ' + dateFormat.format(new Date(message.created_at));
+        const text = document.createElement('span');
+        text.textContent = (message.image ? '[图片] ' : '') + message.text;
+        result.append(detail, text);
+        result.addEventListener('click', () => {
+          dialog.close();
+          context.openMessage(message.id);
+        });
+        row.append(result);
+        results.append(row);
+      }
+      cursor = page.messages[page.messages.length - 1]?.seq;
+      more.hidden = !page.has_more || !cursor;
+      status.textContent = results.childElementCount ? '' : '没有找到符合条件的消息';
+    } catch{
+      if(serial === run && dialog.open) status.textContent = '搜索失败，请重试';
+    } finally {
+      if(serial === run) more.disabled = false;
+    }
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    void load(false);
+  });
+  more.addEventListener('click', () => void load(true));
+  document.body.append(dialog);
+  dialog.showModal();
+}
+
+export function installOrderMediaActions(getContext: () => OrderSearch | undefined) {
+  const observed = '.topbar-search-input-tools, .media-viewer-author, .popup-peer.popup-delete-chat, .pinned-message-unpin';
+  function addAction(container: Element) {
+    const context = getContext();
+    if(!context || container.querySelector(':scope > button[data-tt-order-media-action]')) return;
+    if(container instanceof HTMLButtonElement && container.matches('.pinned-message-unpin')) {
+      container.toggleAttribute('data-tt-shared-pin-readonly', context.isOrder && !context.canPin);
+      return;
+    }
+    if(container.matches('.popup-peer')) {
+      if(!context.isOrder) return;
+      for(const label of container.querySelectorAll<HTMLElement>('.popup-peer-checkbox-row .i18n')) {
+        const translation = I18n.weakMap.get(label);
+        if(translation instanceof I18n.IntlElement && translation.key === 'PinNotify') {
+          const row = label.closest<HTMLElement>('.popup-peer-checkbox-row');
+          row.hidden = true;
+        }
+      }
+      return;
+    }
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.ttOrderMediaAction = '';
+    if(container.matches('.topbar-search-input-tools')) {
+      button.className = 'btn-icon tt-order-search-filter';
+      button.title = '搜索筛选';
+      button.setAttribute('aria-label', button.title);
+      button.append(Icon('filter'));
+      button.addEventListener('click', () => {
+        const context = getContext();
+        const input = container.parentElement.querySelector<HTMLInputElement>('.topbar-search-input');
+        if(context && !document.querySelector('.tt-order-search[open]')) showSearch(context, input?.value ?? '');
+      });
+      container.prepend(button);
+    } else if(context.isOrder && container.closest('.media-viewer-whole')?.querySelector('.media-viewer-caption')) {
+      button.className = 'tt-order-media-jump';
+      button.textContent = '跳到原消息';
+      button.addEventListener('mousedown', (event) => event.stopPropagation());
+      button.addEventListener('click', (event) => {
+        event.stopPropagation();
+        const viewer = (window as Window & {appMediaViewer?: AppMediaViewer}).appMediaViewer;
+        const context = getContext();
+        const target = viewer?.target;
+        if(!target?.mid || target.mid === Number.MAX_SAFE_INTEGER || target.peerId !== context?.peerId) return;
+        button.disabled = true;
+        void viewer.closeWhenIdle().then(() => context.openMessage(target.mid, true), () => {
+          button.disabled = false;
+        });
+      });
+      container.append(button);
+    }
+  }
+
+  document.querySelectorAll(observed).forEach(addAction);
+  new MutationObserver((records) => {
+    for(const {addedNodes, target} of records) {
+      if(addedNodes.length && target instanceof Element) {
+        const popup = target.closest('.popup-peer.popup-delete-chat');
+        if(popup) addAction(popup);
+      }
+      for(const node of addedNodes) {
+        if(!(node instanceof Element)) continue;
+        if(node.matches(observed)) addAction(node);
+        node.querySelectorAll(observed).forEach(addAction);
+      }
+    }
+  }).observe(document.body, {childList: true, subtree: true});
+
+  return () => document.querySelectorAll('.chat.active .pinned-message-unpin').forEach(addAction);
+}
