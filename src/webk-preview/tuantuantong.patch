+import Icon from '@components/icon';
+import {positionMenuTrigger} from '@helpers/positionMenu';
+import './h5ListControls.css';
+
+export function installH5ListControls(closeFromList: () => void) {
+  const pencil = document.querySelector('#column-left .item-main #new-menu');
+  if(!pencil?.parentElement) return false;
+  pencil.classList.add('tt-h5-list-pencil');
+
+  const close = document.createElement('button');
+  close.type = 'button';
+  close.className = 'tt-h5-close-chat';
+  close.setAttribute('aria-label', '关闭内部沟通');
+  close.append(Icon('close'));
+  close.addEventListener('click', () => {
+    if(close.getClientRects().length) closeFromList();
+  });
+  pencil.after(close);
+  return true;
+}
+
+export function positionH5ComposeMenu(menu: HTMLElement, trigger: HTMLElement) {
+  menu.classList.replace('top-left', 'top-right');
+  menu.style.removeProperty('right');
+  positionMenuTrigger(trigger, menu, 'top-right', {bottom: 10});
+}
