+          onClick: () => order.editRemark(dialogPeerId)
+        }]);
+        menu.lastElementChild.setAttribute('data-preview-remark', '');
+      }
+    }
+    if(order?.isH5 && trigger?.id === 'new-menu') {
+      positionH5ComposeMenu(menu, trigger);
+    } else if(order?.isH5 && dialogPeerId !== undefined) {
+      for(const item of menu.querySelectorAll<HTMLElement>(':scope > .btn-menu-item')) {
+        if(!item.hasAttribute('data-preview-remark') && !hasLabel(item, menuLabelSelector, h5DialogItems)) {
+          setButtonMenuItemDisabled(undefined, true, item);
+        }
+      }
+    } else if(order && trigger?.matches('attach-menu-button.attach-file')) {
+      for(const item of menu.querySelectorAll<HTMLElement>(':scope > .btn-menu-item')) {
+        if(!hasLabel(item, menuLabelSelector, attachImageLabel)) {
+          setButtonMenuItemDisabled(undefined, true, item);
+        }
+      }
+    } else if(order?.isOrderGroup() && trigger?.classList.contains('pinned-message-menu')) {
+      const hidePinned = new Set<LangPackKey>(['Popup.Unpin.HideTitle']);
+      for(const item of menu.querySelectorAll<HTMLElement>(':scope > .btn-menu-item')) {
+        if(hasLabel(item, menuLabelSelector, hidePinned)) item.remove();
+      }
+      removeOrphanSeparators(menu);
+    } else if(isMainMenu || isConversationMenu) {
+      const hiddenItems = isMainMenu ? hiddenMainItems : hiddenConversationItems;
+      for(const item of menu.querySelectorAll<HTMLElement>(':scope > .btn-menu-item')) {
+        const icon = item.querySelector('.btn-menu-item-icon');
+        if(isMainMenu && order?.openWorkerDirectory && hasLabel(item, menuLabelSelector, contactsLabel)) {
+          appendButtonMenuItems(menu, [{icon: 'user', regularText: '通讯录', onClick: order.openWorkerDirectory}]);
+          item.replaceWith(menu.lastElementChild);
+        } else if(hasLabel(item, menuLabelSelector, hiddenItems) || (isConversationMenu && icon?.textContent === deleteIcon) ||
+          (isMainMenu && order?.openWorkerDirectory && hasLabel(item, menuLabelSelector, createConversationLabel))) {
+          item.remove();
+        }
+      }
+      // Remove leading and trailing separators before Web K assigns focus.
+      removeOrphanSeparators(menu);
+    } else if(trigger?.closest('.profile-actions')) {
+      for(const item of menu.querySelectorAll<HTMLElement>(':scope > .btn-menu-item')) {
+        if(hasLabel(item, menuLabelSelector, disabledProfileMenuItems) ||
+          (order?.isOrderGroup() && hasLabel(item, menuLabelSelector, orderGroupLeaveMenu))) {
+          setButtonMenuItemDisabled(undefined, true, item);
+        }
+      }
+    }
+    openBtnMenu(menu, onClose, trigger, activateFocus);
+  };
+}
