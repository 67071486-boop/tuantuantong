@@ -0,0 +1,91 @@
+import type {AppImManager} from '@lib/appImManager';
+import ButtonIcon from '@components/buttonIcon';
+import rootScope from '@lib/rootScope';
+import type {Conversation} from './liveTransport';
+import './conversationLabels.css';
+
+export function installConversationLabels(
+  conversations: ReadonlyMap<PeerId, Conversation>,
+  manager: AppImManager,
+  openOrder: (number: string) => void
+) {
+  const sidebar = document.getElementById('column-left');
+  if(!sidebar) return;
+
+  function refresh() {
+    for(const row of sidebar.querySelectorAll<HTMLElement>('.chatlist-chat[data-peer-id]')) {
+      const peerId = Number(row.dataset.peerId).toPeerId(false);
+      const conversation = conversations.get(peerId);
+      const title = row.querySelector('.dialog-title .user-title');
+      if(!title) continue;
+      let personalTitle = title.querySelector<HTMLElement>(':scope > .preview-personal-title');
+      title.classList.toggle('preview-has-personal-title', Boolean(conversation?.remark));
+      if(!conversation?.remark) {
+        personalTitle?.remove();
+      } else {
+        if(!personalTitle) {
+          personalTitle = document.createElement('span');
+          personalTitle.className = 'preview-personal-title';
+          const name = document.createElement('span');
+          const original = document.createElement('small');
+          personalTitle.append(name, original);
+          title.append(personalTitle);
+        }
+        const [name, original] = personalTitle.children;
+        if(name.textContent !== conversation.remark) name.textContent = conversation.remark;
+        const orderNumber = conversation.kind === 'order' ? conversation.order_no : '';
+        if(original.textContent !== orderNumber) original.textContent = orderNumber;
+      }
+      let mention = row.querySelector<HTMLElement>('.preview-mentioned');
+      const indicator = row.querySelector('.dialog-subtitle');
+      if(!indicator || !conversation?.unread_mentions_count) {
+        mention?.remove();
+      } else if(!mention) {
+        mention = document.createElement('span');
+        mention.className = 'preview-mentioned';
+        mention.textContent = '有人 @ 我';
+        indicator.prepend(mention);
+      }
+    }
+  }
+
+  function refreshOrderButton() {
+    for(const chat of manager.chats) {
+      const actions = chat.container.querySelector('.chat-utils');
+      if(!actions) continue;
+      const number = conversations.get(chat.peerId);
+      const orderNo = number?.kind === 'order' ? number.local_order_no : undefined;
+      let button = actions.querySelector<HTMLButtonElement>('.preview-order-link');
+      if(!orderNo || !/^\d{20}$/.test(orderNo)) {
+        button?.remove();
+        continue;
+      }
+      if(!button) {
+        button = ButtonIcon('link preview-order-link force-show-on-mobile') as HTMLButtonElement;
+        button.type = 'button';
+        button.title = '查看订单群聊';
+        button.setAttribute('aria-label', button.title);
+        actions.prepend(button);
+      }
+      button.dataset.previewOrderNo = orderNo;
+    }
+  }
+
+  document.addEventListener('click', (event) => {
+    if(!(event.target instanceof Element)) return;
+    const control = event.target.closest<HTMLButtonElement>('.preview-order-link');
+    if(!control?.dataset.previewOrderNo) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    openOrder(control.dataset.previewOrderNo);
+  }, true);
+
+  new MutationObserver(refresh).observe(sidebar, {childList: true, subtree: true});
+  const center = document.getElementById('column-center');
+  if(center) new MutationObserver(refreshOrderButton).observe(center, {childList: true, subtree: true});
+  rootScope.addEventListener('dialogs_multiupdate', refresh);
+  rootScope.addEventListener('dialogs_multiupdate', refreshOrderButton);
+  manager.addEventListener('peer_changed', refreshOrderButton);
+  refresh();
+  refreshOrderButton();
+}
