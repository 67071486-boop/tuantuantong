diff --git a/src/pages/localChatPreview/workerDirectory.ts b/src/pages/localChatPreview/workerDirectory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..95450e2400e6d33aa89175b0c4fe391768def561
--- /dev/null
+++ b/src/pages/localChatPreview/workerDirectory.ts
@@ -0,0 +1,94 @@
+import Icon from '@components/icon';
+import type {Contact} from './liveTransport';
+import './workerDirectory.css';
+
+export function installWorkerDirectory(isH5: boolean, open: () => void) {
+  document.body.classList.add('tt-worker-directory');
+  if(!isH5) return;
+
+  const pencil = document.getElementById('new-menu');
+  if(!pencil?.parentElement) return;
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.className = 'tt-worker-directory-button';
+  button.setAttribute('aria-label', '通讯录');
+  button.append(Icon('user'));
+  button.addEventListener('click', open);
+  pencil.parentElement.append(button);
+}
+
+export function showWorkerDirectory({contacts, openContact}: {
+  contacts: () => Promise<Contact[]>;
+  openContact: (id: number) => Promise<void>;
+}) {
+  if(document.querySelector('.tt-worker-directory-dialog[open]')) return;
+
+  const dialog = document.createElement('dialog');
+  dialog.className = 'tt-worker-directory-dialog';
+  dialog.setAttribute('aria-labelledby', 'tt-worker-directory-title');
+  dialog.innerHTML = `
+    <header><h2 id="tt-worker-directory-title">通讯录</h2><button type="button" class="btn-icon" aria-label="关闭"></button></header>
+    <p role="status"></p>
+    <ul></ul>
+    <button type="button" class="tt-worker-directory-reload" hidden>重新加载</button>`;
+  const close = dialog.querySelector<HTMLButtonElement>('header button');
+  const status = dialog.querySelector('p');
+  const list = dialog.querySelector('ul');
+  const reload = dialog.querySelector<HTMLButtonElement>('.tt-worker-directory-reload');
+  close.append(Icon('close'));
+  close.addEventListener('click', () => dialog.close());
+  dialog.addEventListener('close', () => dialog.remove());
+  dialog.addEventListener('cancel', (event) => {
+    if(close.disabled) event.preventDefault();
+  });
+
+  async function load() {
+    status.textContent = '正在加载通讯录…';
+    list.replaceChildren();
+    reload.hidden = true;
+    try {
+      const people = await contacts();
+      if(!dialog.open) return;
+      status.textContent = people.length ? '' : '管理员尚未配置可联系的客服';
+      for(const {id, name, is_primary: isPrimary} of people) {
+        const row = document.createElement('li');
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.textContent = name;
+        if(isPrimary) {
+          const primary = document.createElement('small');
+          primary.textContent = '首选客服';
+          button.append(primary);
+        }
+        button.addEventListener('click', async() => {
+          close.disabled = true;
+          reload.hidden = true;
+          const buttons = list.querySelectorAll('button');
+          buttons.forEach((item) => item.disabled = true);
+          status.textContent = '正在打开会话…';
+          try {
+            await openContact(id);
+            dialog.close();
+          } catch(error) {
+            status.textContent = error instanceof Error ? error.message : '打开会话失败，请重试';
+            reload.hidden = false;
+          } finally {
+            close.disabled = false;
+            buttons.forEach((item) => item.disabled = false);
+          }
+        });
+        row.append(button);
+        list.append(row);
+      }
+    } catch{
+      if(!dialog.open) return;
+      status.textContent = '通讯录加载失败，请重试';
+      reload.hidden = false;
+    }
+  }
+
+  reload.addEventListener('click', () => void load());
+  document.body.append(dialog);
+  dialog.showModal();
+  void load();
+}
