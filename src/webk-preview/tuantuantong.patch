index 0000000000000000000000000000000000000000..ea1a04fc210dc5779b98b29d9611c284e6ae710a
--- /dev/null
+++ b/src/pages/localChatPreview/composerImages.ts
@@ -0,0 +1,254 @@
+import {seedMirror} from '@components/popupSandbox/bootstrapState';
+import apiManagerProxy from '@lib/apiManagerProxy';
+import type {DownloadMediaOptions} from '@appManagers/apiFileManager';
+import type {MessageMedia} from '@layer';
+import type {ChatImage, ChatImageData, ChatMessage} from './liveTransport';
+
+export const IMAGE_MAX_BYTES = 1024 * 1024;
+const ALBUM_MAX_BYTES = 1_835_008;
+const ALBUM_MAX_FILES = 10;
+export const IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp'] as const;
+const IMAGE_ACCEPT = IMAGE_TYPES.join(',');
+const IMAGE_ONLY = '目前仅支持发送 JPG、PNG 或 WebP 图片';
+const VOICE_DISABLED = '暂不支持发送语音';
+const fileInputSelector = '.chat-input input[type="file"], .popup-new-media input[type="file"]';
+const sendButtonSelector = 'button.btn-send';
+const recordingButtonSelector = 'button.btn-send.record, button.btn-send.record-video';
+const photoIdPrefix = 'tt-image:';
+const photoSizeType = 'x';
+const cachedImageLimit = 24;
+
+function isImageMime(value: string): value is ChatImageData['mime'] {
+  return IMAGE_TYPES.some((mime) => mime === value);
+}
+
+function imageValidationError(file: Blob) {
+  if(!isImageMime(file.type)) return IMAGE_ONLY;
+  if(!file.size) return '图片为空';
+  if(file.size > IMAGE_MAX_BYTES) return '图片不能超过 1 MB';
+}
+
+export async function encodeChatImage(file: unknown): Promise<ChatImageData> {
+  if(!(file instanceof Blob) || !isImageMime(file.type)) throw new Error(IMAGE_ONLY);
+  const error = imageValidationError(file);
+  if(error) throw new Error(error);
+  const mime = file.type;
+  const data = await new Promise<string>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onerror = () => reject(new Error('读取图片失败'));
+    reader.onload = () => resolve((reader.result as string).split(',', 2)[1]);
+    reader.readAsDataURL(file);
+  });
+  return {mime, data};
+}
+
+async function compressAlbumImage(file: Blob, target: number) {
+  if(file.size <= target) return file;
+  const bitmap = await createImageBitmap(file);
+  const canvas = document.createElement('canvas');
+  let size = Math.min(1, Math.sqrt(target / file.size) * 1.5);
+  try {
+    for(let attempt = 0; attempt < 5; ++attempt, size *= .72) {
+      canvas.width = Math.max(1, Math.round(bitmap.width * size));
+      canvas.height = Math.max(1, Math.round(bitmap.height * size));
+      canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
+      const compressed = await new Promise<Blob>((resolve) => canvas.toBlob(resolve, 'image/webp', .8));
+      if(compressed?.size && compressed.size <= target) return compressed;
+    }
+  } finally {
+    bitmap.close();
+  }
+  throw new Error('多图合计过大，请减少图片后重试');
+}
+
+export async function encodeChatAlbum(files: unknown[]) {
+  if(files.length < 2 || files.length > ALBUM_MAX_FILES) throw new Error('每组可发送 2–10 张图片');
+  const originals = files.map((file) => {
+    if(!(file instanceof Blob)) throw new Error(IMAGE_ONLY);
+    const error = imageValidationError(file);
+    if(error) throw new Error(error);
+    return file;
+  });
+  const size = originals.reduce((sum, file) => sum + file.size, 0);
+  if(size <= ALBUM_MAX_BYTES) return Promise.all(originals.map(encodeChatImage));
+  const allotment = Math.floor(ALBUM_MAX_BYTES / originals.length);
+  const images = await Promise.all(originals.map((file) => compressAlbumImage(file, allotment)));
+  return Promise.all(images.map(encodeChatImage));
+}
+
+export function chatPhoto(message: ChatMessage, image: ChatImage): MessageMedia.messageMediaPhoto {
+  return {
+    _: 'messageMediaPhoto',
+    pFlags: {},
+    photo: {
+      _: 'photo',
+      pFlags: {},
+      id: photoIdPrefix + message.id,
+      access_hash: '0',
+      file_reference: [],
+      date: Math.floor(Date.parse(message.created_at) / 1000),
+      sizes: [{_: 'photoSize', type: photoSizeType, w: image.width, h: image.height, size: 0}],
+      dc_id: 0
+    }
+  };
+}
+
+export function chatPhotoDownloads(
+  getMessage: (mid: number) => ChatMessage | undefined,
+  getImage: (conversationId: number, messageId: number) => Promise<ChatImageData>
+) {
+  const cached = new Map<number, string>();
+  const pending = new Map<number, Promise<string>>();
+
+  function release(mid: number, revoke = false) {
+    const url = cached.get(mid);
+    if(!url) return;
+    if(revoke) {
+      document.querySelectorAll<HTMLImageElement>('img[src]').forEach((image) => {
+        if(image.getAttribute('src') === url) image.removeAttribute('src');
+      });
+    }
+    URL.revokeObjectURL(url);
+    cached.delete(mid);
+    seedMirror('thumbs', 'photo' + photoIdPrefix + mid, undefined);
+  }
+
+  function requireMessage(mid: number) {
+    const message = getMessage(mid);
+    if(!message?.image || message.revoked) throw new Error('图片不可查看');
+    return message;
+  }
+
+  function midFor({media}: DownloadMediaOptions) {
+    if(media._ !== 'photo' || typeof media.id !== 'string' || !media.id.startsWith(photoIdPrefix)) {
+      throw new Error('此图片不在团团通会话中');
+    }
+    return Number(media.id.slice(photoIdPrefix.length));
+  }
+
+  async function read(mid: number) {
+    const message = requireMessage(mid);
+    const {mime, data} = await getImage(message.conversation_id, mid);
+    requireMessage(mid);
+    if(!isImageMime(mime)) throw new Error('图片不可查看');
+    return new Blob([Uint8Array.from(atob(data), (character) => character.charCodeAt(0))], {type: mime});
+  }
+
+  function remember(mid: number, image: Blob) {
+    requireMessage(mid);
+    const url = URL.createObjectURL(image);
+    cached.set(mid, url);
+    seedMirror('thumbs', 'photo' + photoIdPrefix + mid, {
+      [photoSizeType]: {type: photoSizeType, downloaded: image.size, url}
+    });
+    const oldest = cached.keys().next();
+    if(cached.size > cachedImageLimit && !oldest.done) release(oldest.value);
+    return url;
+  }
+
+  return {
+    forget: (mid: number) => release(mid, true),
+    thumbsStorage: {
+      getCacheContext: apiManagerProxy.getCacheContext.bind(apiManagerProxy),
+      deleteCacheContext: (media: DownloadMediaOptions['media']) => {
+        if(media._ === 'photo' && typeof media.id === 'string' && media.id.startsWith(photoIdPrefix)) {
+          release(Number(media.id.slice(photoIdPrefix.length)));
+        }
+      }
+    },
+    manager: {
+      downloadMediaURL: async(options: DownloadMediaOptions) => {
+        const mid = midFor(options);
+        requireMessage(mid);
+        const cachedUrl = cached.get(mid);
+        if(cachedUrl) return cachedUrl;
+        const active = pending.get(mid);
+        if(active) return active;
+        const load = read(mid).then((image) => remember(mid, image)).finally(() => pending.delete(mid));
+        pending.set(mid, load);
+        return load;
+      },
+      downloadMedia: (options: DownloadMediaOptions) => read(midFor(options))
+    }
+  };
+}
+
+export function installImageOnlyComposer(report: (error: string) => void) {
+  function updateRecordingButton(button: HTMLButtonElement) {
+    if(button.matches(recordingButtonSelector)) {
+      button.dataset.previewRecordingDisabled = '';
+      button.disabled = true;
+      button.setAttribute('aria-disabled', 'true');
+      button.title = VOICE_DISABLED;
+    } else if(button.hasAttribute('data-preview-recording-disabled')) {
+      delete button.dataset.previewRecordingDisabled;
+      button.disabled = false;
+      button.removeAttribute('aria-disabled');
+      button.removeAttribute('title');
+    }
+  }
+
+  function updateRecordingButtons(node: Element) {
+    if(node instanceof HTMLButtonElement && node.matches(sendButtonSelector)) updateRecordingButton(node);
+    node.querySelectorAll<HTMLButtonElement>(sendButtonSelector).forEach(updateRecordingButton);
+  }
+
+  new MutationObserver((records) => {
+    for(const record of records) {
+      if(record.type === 'attributes') {
+        if(record.target instanceof HTMLButtonElement && record.target.matches(sendButtonSelector)) {
+          updateRecordingButton(record.target);
+        }
+      } else {
+        for(const node of record.addedNodes) {
+          if(node instanceof Element) updateRecordingButtons(node);
+        }
+      }
+    }
+  }).observe(document.body, {childList: true, subtree: true, attributes: true, attributeFilter: ['class']});
+  updateRecordingButtons(document.body);
+
+  function stop(event: Event) {
+    event.preventDefault();
+    event.stopImmediatePropagation();
+  }
+
+  function validateFiles(event: Event, files: FileList | undefined) {
+    const error = files?.length > ALBUM_MAX_FILES ? '每组最多发送 10 张图片' :
+      Array.from(files ?? [], imageValidationError).find(Boolean);
+    if(!error) return false;
+    stop(event);
+    report(error);
+    return true;
+  }
+
+  function guardRecording(event: Event) {
+    if(event instanceof KeyboardEvent && event.key !== 'Enter' && event.key !== ' ') return;
+    if(event.target instanceof Element && event.target.closest(recordingButtonSelector)) stop(event);
+  }
+
+  for(const event of ['click', 'mousedown', 'pointerdown', 'contextmenu', 'keydown']) {
+    document.addEventListener(event, guardRecording, true);
+  }
+
+  document.addEventListener('click', (event) => {
+    if(!(event.target instanceof Element)) return;
+    const input = event.target.closest<HTMLInputElement>(fileInputSelector);
+    if(input) input.accept = IMAGE_ACCEPT;
+  }, true);
+
+  document.addEventListener('change', (event) => {
+    const input = event.target;
+    if(!(input instanceof HTMLInputElement) || !input.matches(fileInputSelector)) return;
+    if(!validateFiles(event, input.files)) return;
+    input.value = '';
+    input.dispatchEvent(new Event('cancel'));
+  }, true);
+
+  document.addEventListener('paste', (event) => {
+    validateFiles(event, event.clipboardData?.files);
+  }, true);
+  document.addEventListener('drop', (event) => {
+    validateFiles(event, event.dataTransfer?.files);
+  }, true);
+}
