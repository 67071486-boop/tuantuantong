+
+const h5DialogItems = new Set<LangPackKey>([
+  'Message.Context.Select',
+  'ChatList.Context.Preview',
+  'MarkAsUnread',
+  'ChatList.Context.Pin',
+  'ChatList.Context.Unpin'
