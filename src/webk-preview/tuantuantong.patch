+/* Autofocus can scroll the page sideways while the narrow chat is opening. */
+body:has(.chat.active > .chat-search-footer) {
+  overflow: clip;
+}
+
+.chat:has(> .chat-search-footer) > .topbar {
+  z-index: 4;
+
+  .topbar-search-left-container {
+    --border-radius: 999px;
+    margin-inline: 44px 6px;
+    min-width: 0;
+  }
+
+  .topbar-search-left-background {
+    background: var(--surface-color);
+    box-shadow: 0 2px 12px rgb(0 0 0 / 14%);
