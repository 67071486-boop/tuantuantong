+
+const disabledProfileMenuItems = new Set<LangPackKey>([
+  'BlockUser',
+  'ChatList.Context.Mute',
+  'ChatList.Context.Unmute'
+]);
+const disabledProfileTiles = new Set<LangPackKey>(['Call.Mute', 'VoipUnmute']);
+const orderMemberProfileTiles = new Set<LangPackKey>(['Message', ...disabledProfileTiles]);
+const orderMemberProfileRows = new Set<LangPackKey>(['AddContactTitle', 'BlockUser', 'Unblock']);
+const orderGroupLeaveTile = new Set<LangPackKey>(['VoiceChat.Leave']);
+const orderGroupLeaveMenu = new Set<LangPackKey>(['LeaveMegaMenu']);
+type OrderProfileOptions = {
+  isOrderGroup: () => boolean;
+  isOrderMember: (peerId: PeerId) => boolean;
+  openMemberProfile: (peerId: PeerId) => void;
+  selfId: PeerId;
+  editRemark: (peerId: PeerId) => void;
+  hasConversation: (peerId: PeerId) => boolean;
