diff --git a/src/pages/localChatPreview/liveSearchLayout.ts b/src/pages/localChatPreview/liveSearchLayout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..395ecbf4e48203d969ddc4dcddaa78e39ea9d96c
--- /dev/null
+++ b/src/pages/localChatPreview/liveSearchLayout.ts
@@ -0,0 +1,25 @@
+import './liveSearchLayout.css';
+
+export function installLiveSearchLayout(updateTopbar: () => void) {
+  const column = document.getElementById('column-center');
+  if(!column) return;
+
+  const openedLists = new WeakSet<Element>();
+  const observer = new MutationObserver(() => {
+    const chat = column.querySelector('.chat.active');
+    const topbar = chat?.querySelector('.topbar.hide-pinned');
+    if(topbar && !topbar.querySelector('.topbar-search-container')) {
+      topbar.classList.remove('hide-pinned', 'search-top-active');
+      updateTopbar();
+    }
+
+    const results = chat?.querySelector('.chat-search-results:has(+ .chat-search-footer)');
+    const list = results?.querySelector('.topbar-search-left-results-list');
+    const toggle = chat?.querySelector<HTMLElement>('.chat-search-footer-right:not(.hide) .chat-search-footer-type');
+    if(!list?.querySelector('.chatlist-chat') || !toggle || openedLists.has(list)) return;
+
+    openedLists.add(list);
+    if(!results.classList.contains('active')) toggle.click();
+  });
+  observer.observe(column, {childList: true, subtree: true});
+}
diff --git a/src/pages/localChatPreview/liveTransport.ts b/src/pages/localChatPreview/liveTransport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..775bd53e6a1a31b212628f458ba0beeaf2f77126
--- /dev/null
+++ b/src/pages/localChatPreview/liveTransport.ts
@@ -0,0 +1,216 @@
+export type ChatImage = {mime: ChatImageData['mime']; width: number; height: number};
+export type ChatImageData = {mime: 'image/jpeg' | 'image/png' | 'image/webp'; data: string};
+
+export type Contact = {id: number; name: string; avatar_url: string | null; is_primary?: boolean};
+type ContactDirectory = {contacts: Contact[]; worker_directory_only?: boolean};
+
+export type ChatMessage = {
+  id: number;
+  seq: number;
+  conversation_id: number;
+  sender_id: number;
+  text: string;
+  created_at: string;
+  revoked: boolean;
+  reply_to_id: number | null;
+  image?: ChatImage;
+  album_id?: string | null;
+  mention_member_ids?: number[];
+};
+
+export type SendBody = {
+  text: string;
+  client_id: string;
+  reply_to_id?: number;
+  image?: ChatImageData;
+  mention_member_ids?: number[];
+};
+
+export type AlbumSendBody = Omit<SendBody, 'image'> & {images: ChatImageData[]};
+export type ChatSearchFilters = {senderId?: number; dateFrom?: number; dateTo?: number; imageOnly?: boolean};
+
+export type ConversationPreferences = {pinned?: boolean; remark?: string; marked_unread?: boolean};
+
+type ConversationSummary = ConversationPreferences & {
+  id: number;
+  last_message: ChatMessage | null;
+  unread_count: number;
+  read_seq: number;
+  peer_read_seq: number;
+  first_unread_message_id?: number | null;
+  first_unread_mention_id?: number | null;
+  unread_mentions_count?: number;
+};
+
+export type OrderMember = Contact & {
+  left_at: string | null;
+  studio_name?: string;
+  order_role?: 'worker' | 'acceptor' | 'publisher' | 'follower' | 'viewer' | '';
+};
+export type OrderConversation = ConversationSummary & {
+  kind: 'order';
+  title: string;
+  order_no: string;
+  local_order_no?: string;
+  members: OrderMember[];
+  self_member_id: number | null;
+  is_member?: boolean;
+  can_join?: boolean;
+  pinned_message_id?: number | null;
+  can_pin_messages?: boolean;
+};
+
+export type OrderHistoryActionState = {busy: boolean; error?: string};
+export type Conversation = OrderConversation | (ConversationSummary & {kind?: 'direct'; peer: Contact});
+
+type History = {messages: ChatMessage[]; has_more: boolean; has_newer: boolean};
+type SearchResults = {messages: ChatMessage[]; count: number; has_more: boolean};
+
+type Change = {
+  kind: 'message.created' | 'message.revoked' | 'conversation.read' | 'conversation.created' |
+    'conversation.members_changed' | 'conversation.removed' | 'conversation.preferences_changed' | 'conversation.pin_changed';
+  conversation_id: number;
+  message: ChatMessage | null;
+};
+
+export function createLiveTransport(orderNo?: string) {
+  const parentOrigin = document.referrer && new URL(document.referrer).origin;
+  const allowedParents = [
+    'http://localhost:5181',
+    'http://127.0.0.1:5181',
+    'http://127.0.0.1:5182',
+    'http://localhost:5182',
+    'http://127.0.0.1:5183',
+    'http://127.0.0.1:5184'
+  ];
+  if(window.parent === window || !allowedParents.includes(parentOrigin)) {
+    throw new Error('请在团团通后台打开内部通讯');
+  }
+
+  const api = '/api/internal-chat/';
+  const orderPath = orderNo && api + `orders/${orderNo}/`;
+  let nextId = 0;
+  const pending = new Map<number, {
+    resolve: (data: unknown) => void;
+    reject: (error: Error) => void;
+    timer: number;
+  }>();
+  const changed = new EventTarget();
+  const visibility = new EventTarget();
+  let visible = false;
+  let listControlsReady = false;
+  let openConversation: (id: number) => void;
+  let handleBack: () => boolean;
+  let orderHistoryActionState: (state: OrderHistoryActionState) => void;
+
+  function reportListControlsReady() {
+    listControlsReady = true;
+    window.parent.postMessage({type: 'tt:chat.listControlsReady'}, parentOrigin);
+  }
+
+  window.addEventListener('message', (event) => {
+    if(event.origin !== parentOrigin || event.source !== window.parent) return;
+    const data = event.data;
+    if(data?.type === 'tt:chat.visible') {
+      visible = data.detail === true;
+      visibility.dispatchEvent(new Event('change'));
+    } else if(data?.type === 'tt:chat.changed') {
+      changed.dispatchEvent(new Event('change'));
+    } else if(data?.type === 'tt:chat.back' && handleBack && Number.isSafeInteger(data.id) && data.id > 0) {
+      window.parent.postMessage({type: 'tt:chat.backResult', id: data.id, detail: handleBack()}, parentOrigin);
+    } else if(data?.type === 'tt:chat.requestListControlsReady' && listControlsReady) {
+      reportListControlsReady();
+    } else if(data?.type === 'tt:chat.openConversation' && Number.isSafeInteger(data.detail) && data.detail > 0) {
+      openConversation?.(data.detail);
+    } else if(orderPath && data?.type === 'tt:order-history.action-state' && typeof data.detail?.busy === 'boolean') {
+      orderHistoryActionState?.({
+        busy: data.detail.busy,
+        error: typeof data.detail.error === 'string' ? data.detail.error : undefined
+      });
+    } else if(data?.type === 'tt:chat.response') {
+      const item = pending.get(data.id);
+      if(!item) return;
+      pending.delete(data.id);
+      window.clearTimeout(item.timer);
+      if(typeof data.error === 'string') item.reject(new Error(data.error));
+      else item.resolve(data.result);
+    }
+  });
+  window.parent.postMessage({type: 'tt:chat.ready'}, parentOrigin);
+
+  function request<T>(method: 'get' | 'post', path: string, body?: object): Promise<T> {
+    if(orderPath && (method !== 'get' || !path.startsWith(orderPath))) {
+      return Promise.reject(new Error('订单消息预览只能读取当前订单'));
+    }
+    const id = ++nextId;
+    return new Promise<T>((resolve, reject) => {
+      const timer = window.setTimeout(() => {
+        pending.delete(id);
+        reject(new Error('聊天请求超时'));
+      }, 20_000);
+      pending.set(id, {resolve: (data) => resolve(data as T), reject, timer});
+      window.parent.postMessage({type: 'tt:chat.request', id, method, path, body}, parentOrigin);
+    });
+  }
+
+  const conversationPath = (id: number) => orderPath || `${api}conversations/${id}/`;
+
+  return {
+    changed,
+    visibility,
+    orderSummary: () => request<OrderConversation>('get', orderPath),
+    reportOrderHistory: (ready: boolean) => window.parent.postMessage(ready ?
+      {type: 'tt:order-history.ready'} :
+      {type: 'tt:order-history.error', detail: '无法加载订单聊天记录'}, parentOrigin),
+    activateOrderHistory: () => {
+      if(orderPath) window.parent.postMessage({type: 'tt:order-history.activate'}, parentOrigin);
+    },
+    onOrderHistoryActionState: (handler: (state: OrderHistoryActionState) => void) => {
+      orderHistoryActionState = handler;
+    },
+    visible: () => visible && !document.hidden,
+    connectNavigation: (handler: (id: number) => void) => {
+      openConversation = handler;
+      window.parent.postMessage({type: 'tt:chat.navigationReady'}, parentOrigin);
+    },
+    connectBack: (handler: () => boolean) => { handleBack = handler; },
+    reportListControlsReady,
+    closeFromList: () => window.parent.postMessage({type: 'tt:chat.closeFromList'}, parentOrigin),
+    openOrder: (number: string) => {
+      if(/^\d{20}$/.test(number)) window.parent.postMessage({type: 'tt:chat.openOrder', detail: number}, parentOrigin);
+    },
+    me: () => request<{user: {id: number; display_name: string}}>('get', '/api/auth/me'),
+    contacts: () => request<ContactDirectory>('get', api + 'contacts/'),
+    conversations: () => request<{conversations: Conversation[]; cursor?: number}>('get', api + 'conversations/'),
+    start: (peer: number) => request<Conversation>('post', api + 'conversations/', {peer_id: peer}),
+    history: (id: number, query: Record<string, string> = {}) => request<History>(
+      'get', conversationPath(id) + 'messages/' + (Object.keys(query).length ? '?' + new URLSearchParams(query) : '')
+    ),
+    search: (id: number, query: string, before?: number, filters: ChatSearchFilters = {}) => {
+      const params = new URLSearchParams();
+      if(query) params.set('q', query);
+      if(before) params.set('before', String(before));
+      if(filters.senderId) params.set('sender_id', String(filters.senderId));
+      if(filters.dateFrom !== undefined) params.set('date_from', String(filters.dateFrom));
+      if(filters.dateTo !== undefined) params.set('date_to', String(filters.dateTo));
+      if(filters.imageOnly) params.set('image_only', '1');
+      return request<SearchResults>('get', conversationPath(id) + 'messages/search/?' + params);
+    },
+    send: (id: number, body: SendBody) =>
+      request<ChatMessage>('post', conversationPath(id) + 'messages/', body),
+    sendAlbum: (id: number, body: AlbumSendBody) =>
+      request<{messages: ChatMessage[]}>('post', conversationPath(id) + 'messages/', body),
+    pin: (id: number, messageId: number | null) =>
+      request<{pinned_message_id: number | null}>('post', conversationPath(id) + 'pin/', {message_id: messageId}),
+    preferences: (id: number, body: ConversationPreferences) =>
+      request<ConversationPreferences>('post', conversationPath(id) + 'preferences/', body),
+    image: (id: number, messageId: number) =>
+      request<ChatImageData>('get', conversationPath(id) + `messages/${messageId}/image/`),
+    read: (id: number, seq: number) => request<{read_seq: number}>('post', conversationPath(id) + 'read/', {seq}),
+    revoke: (id: number, messageId: number) =>
+      request<ChatMessage>('post', conversationPath(id) + `messages/${messageId}/revoke/`),
+    sync: (after: number) => request<{cursor: number; has_more: boolean; changes: Change[]}>(
+      'get', api + `sync/?after=${after}`
+    )
+  };
+}
