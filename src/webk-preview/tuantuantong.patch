@@ -0,0 +1,32 @@
+import type {LangPackString} from '@layer';
+import {fillLocalizedDates} from '@helpers/date';
+import commonStateStorage from '@lib/commonStateStorage';
+import I18n from '@lib/langPack';
+import {zhHansOverrides} from './zhHansOverrides';
+import supplementalStrings from './zhHansSupplement.json';
+import telegramStrings from './zhHansTelegram.json';
+
+export async function installChineseLanguage() {
+  const fallback = await I18n.loadLocalLangPack();
+  const strings = new Map(fallback.strings.map((string) => [string.key, string]));
+
+  const translations = [
+    ...telegramStrings as LangPackString[],
+    ...supplementalStrings as LangPackString[],
+    ...I18n.formatLocalStrings(zhHansOverrides)
+  ];
+  for(const string of translations) {
+    strings.set(string.key, string);
+  }
+
+  // Apply through the native cache reader without writing the preview language to disk.
+  await commonStateStorage.set({langPack: {
+    ...fallback,
+    lang_code: 'zh-Hans',
+    rtl: false,
+    strings: [...strings.values()]
+  }}, true);
+  await I18n.getCacheLangPackAndApply();
+  fillLocalizedDates();
+  document.documentElement.style.setProperty('--unread-messages-text', JSON.stringify(I18n.format('UnreadMessages', true)));
+}
diff --git a/src/pages/localChatPreview/installPreviewMenus.ts b/src/pages/localChatPreview/installPreviewMenus.ts
