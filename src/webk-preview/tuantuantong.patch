+function hasLabel(element: Element, selector: string, keys: ReadonlySet<LangPackKey>) {
+  return Array.from(element.querySelectorAll<HTMLElement>(selector)).some((label) => {
+    const translation = I18n.weakMap.get(label);
+    return translation instanceof I18n.IntlElement && keys.has(translation.key);
+  });
+}
+
+function disableProfileTile(tile: Element, order?: OrderProfileOptions) {
+  if(!(tile instanceof HTMLButtonElement)) return;
+  const labelSelector = '.btn-tile-text';
+  const disabled = hasLabel(tile, labelSelector, disabledProfileTiles) ||
+    (order?.isOrderGroup() && hasLabel(tile, labelSelector, orderGroupLeaveTile));
+  if(disabled) {
+    tile.disabled = true;
+    tile.setAttribute('aria-disabled', 'true');
+  }
+}
+
+function installProfileTileDisabling(order?: OrderProfileOptions) {
+  const sidebar = document.getElementById('column-right');
+  if(!sidebar) return;
+
+  const disableTile = (tile: Element) => disableProfileTile(tile, order);
+  sidebar.querySelectorAll(profileTileSelector).forEach(disableTile);
+  new MutationObserver((records) => {
+    for(const {addedNodes, target} of records) {
+      const existing = target instanceof Element && target.closest(profileTileSelector);
+      if(existing) disableTile(existing);
+      for(const node of addedNodes) {
+        if(!(node instanceof Element)) continue;
+        if(node.matches(profileTileSelector)) disableTile(node);
+        node.querySelectorAll(profileTileSelector).forEach(disableTile);
+      }
+    }
+  }).observe(sidebar, {childList: true, subtree: true});
+}
+
+function installOrderMemberProfileDisabling(order: OrderProfileOptions) {
+  function disableOrderMemberActions(profile: Element) {
+    const peer = profile.querySelector<HTMLElement>('.profile-name .peer-title[data-peer-id]');
+    if(!peer || !order.isOrderMember(peer.dataset.peerId.toPeerId())) return;
+    for(const control of profile.querySelectorAll<HTMLElement>(`${profileTileSelector}, ${profileRowSelector}`)) {
