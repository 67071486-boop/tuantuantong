index 0000000000000000000000000000000000000000..8f25b2b4abfbb90af220e1b129f1c5e121731303
--- /dev/null
+++ b/src/pages/localChatPreview/sendRetry.ts
@@ -0,0 +1,55 @@
+import './sendRetry.css';
+
+export function installSendRetry(contains: (mid: number) => boolean, retry: (mid: number) => Promise<void>) {
+  const scope = document.getElementById('column-center') ?? document.body;
+  const selector = '.bubble.is-error[data-mid]';
+  document.addEventListener('click', async(event) => {
+    if(!(event.target instanceof Element)) return;
+    const button = event.target.closest<HTMLButtonElement>('.preview-send-retry');
+    if(!button || button.disabled) return;
+    const mid = Number(button.dataset.previewRetryMid);
+    if(!contains(mid)) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    button.disabled = true;
+    button.textContent = '正在重试…';
+    try {
+      await retry(mid);
+    } finally {
+      if(!contains(mid)) button.remove();
+      else {
+        button.disabled = false;
+        button.textContent = '发送失败，重试';
+      }
+    }
+  }, true);
+  function prepare(element: Element) {
+    const bubble = element.closest<HTMLElement>(selector);
+    if(!bubble || bubble.querySelector('.preview-send-retry')) return;
+    const mid = Number(bubble.dataset.mid);
+    if(!contains(mid)) return;
+    const content = bubble.querySelector('.bubble-content');
+    if(!content) return;
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'preview-send-retry';
+    button.dataset.previewRetryMid = String(mid);
+    button.textContent = '发送失败，重试';
+    content.append(button);
+  }
+
+  function scan(element: Element) {
+    prepare(element);
+    element.querySelectorAll(selector).forEach(prepare);
+  }
+  new MutationObserver((records) => {
+    for(const record of records) {
+      if(record.type === 'attributes') {
+        if(record.target instanceof HTMLElement && record.target.matches(selector)) prepare(record.target);
+      } else {
+        for(const node of record.addedNodes) if(node instanceof HTMLElement) scan(node);
+      }
+    }
+  }).observe(scope, {subtree: true, childList: true, attributes: true, attributeFilter: ['class']});
+  scan(scope);
+}
