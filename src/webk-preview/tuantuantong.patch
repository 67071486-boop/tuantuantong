diff --git a/src/pages/localChatPreview/composerMentionsEmoji.ts b/src/pages/localChatPreview/composerMentionsEmoji.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09fa732a98c51cb1c682950ad65e734b12614b35
--- /dev/null
+++ b/src/pages/localChatPreview/composerMentionsEmoji.ts
@@ -0,0 +1,135 @@
+import parseEntities from '@lib/richTextProcessor/parseEntities';
+import rootScope from '@lib/rootScope';
+import {getEmojiSkinToneBase, getEmojiSkinToneVariants, type EmojiSkinTone} from '@helpers/emojiSkinTone';
+import type {EmojiList, MessageEntity} from '@layer';
+import type ChatInputInstance from '@components/chat/input';
+import type {OrderMember} from './liveTransport';
+import './composerMentionsEmoji.css';
+
+type OrderRoster = {
+  members: OrderMember[];
+  selfMemberId: number;
+  peerIds: ReadonlyMap<number, PeerId>;
+};
+
+type EmojiSearch = {q: string; limit?: number};
+
+const emojiKeywords = new Map([
+  ['😀', '笑 笑脸 开心 happy smile'],
+  ['😂', '笑哭 搞笑 laugh joy'],
+  ['🙂', '微笑 微微笑 smile'],
+  ['👍', '赞 行 可以 thumbs up like'],
+  ['👌', '可以 好的 ok'],
+  ['✅', '完成 对 勾 通过 done check'],
+  ['❤️', '爱 红心 心 love heart'],
+  ['🎉', '庆祝 恭喜 party celebration'],
+  ['🙏', '谢谢 感谢 thanks please'],
+  ['👋', '你好 再见 hello wave'],
+  ['🤝', '握手 合作 handshake'],
+  ['💪', '加油 努力 strong'],
+  ['😢', '难过 哭 sad cry']
+]);
+
+const recentLimit = 32;
+
+export function getOrderMentionPeers(roster: OrderRoster | undefined, query: string): PeerId[] {
+  if(!roster) return [];
+  const term = query.replace(/^@/, '').trim().toLowerCase();
+  const peers: PeerId[] = [];
+  for(const member of roster.members) {
+    if(member.id === roster.selfMemberId || member.left_at || !member.name.toLowerCase().includes(term)) continue;
+    const peerId = roster.peerIds.get(member.id);
+    if(peerId !== undefined) peers.push(peerId);
+  }
+  return peers;
+}
+
+export function createPreviewEmojiManager() {
+  const recent = [...emojiKeywords.keys()];
+  const variants: Record<string, EmojiSkinTone> = {};
+  return {
+    getRecentEmojis: (type: 'native' | 'custom') => type === 'native' ? [...recent] : [],
+    getEmojiGroups: (): [] => [],
+    getCustomEmojis: (): undefined => undefined,
+    searchCustomEmoji: (): EmojiList.emojiList => ({_: 'emojiList', hash: '0', document_id: []}),
+    getEmojiVariants: () => ({...variants}),
+    saveEmojiVariant: (baseEmoji: string, tone: EmojiSkinTone) => {
+      const skinTones = getEmojiSkinToneVariants(baseEmoji);
+      if(!skinTones) return;
+      variants[baseEmoji] = tone;
+      rootScope.dispatchEvent('emoji_variant', {baseEmoji, emoji: skinTones.variants[tone], tone});
+    },
+    pushRecentEmoji: ({emoji, docId}: AppEmoji) => {
+      if(!emoji || docId) return;
+      const baseEmoji = getEmojiSkinToneBase(emoji);
+      const index = recent.indexOf(baseEmoji);
+      if(index >= 0) recent.splice(index, 1);
+      recent.unshift(baseEmoji);
+      if(recent.length > recentLimit) recent.pop();
+      rootScope.dispatchEvent('emoji_recent', {emoji: {emoji: baseEmoji}});
+    },
+    prepareAndSearchEmojis: ({q, limit = recentLimit}: EmojiSearch) => {
+      const term = q.trim().toLowerCase();
+      if(!term) return [];
+      if(parseEntities(term).some((entity) => entity._ === 'messageEntityEmoji' && entity.length === term.length)) {
+        return [{emoji: term}];
+      }
+      return [...emojiKeywords]
+      .filter(([, keywords]) => keywords.includes(term))
+      .slice(0, limit)
+      .map(([emoji]) => ({emoji}));
+    }
+  };
+}
+
+export async function installPreviewMentions(
+  getRoster: (peerId: PeerId) => OrderRoster | undefined,
+  getActiveInput: () => ChatInputInstance | undefined
+) {
+  const {default: ChatInput} = await import('@components/chat/input');
+  const mentionUser = ChatInput.prototype.mentionUser;
+  ChatInput.prototype.mentionUser = function(peerId, isHelper) {
+    const roster = getRoster(this.chat.peerId);
+    if(!roster || !isHelper) return mentionUser.call(this, peerId, isHelper);
+
+    const member = roster.members.find((member) => roster.peerIds.get(member.id) === peerId);
+    if(!member || member.left_at || member.id === roster.selfMemberId) return;
+    const text = `@${member.name}`;
+    this.insertAtCaret(text + ' ', {
+      _: 'messageEntityMentionName',
+      offset: 0,
+      length: text.length,
+      user_id: peerId.toUserId()
+    }, true);
+  };
+
+  function findChoice(target: EventTarget | null) {
+    const option = target instanceof Element && target.closest<HTMLElement>('.mentions-helper .mentions-helper-list-element[data-peer-id]');
+    const input = getActiveInput();
+    if(!option || !input || !input.chat.container.contains(option) || !getRoster(input.chat.peerId)) return;
+    return {input, peerId: Number(option.dataset.peerId).toPeerId(false)};
+  }
+
+  document.addEventListener('pointerdown', (event) => {
+    if(event.button === 0 && findChoice(event.target)) event.preventDefault();
+  }, true);
+  document.addEventListener('click', (event) => {
+    const choice = findChoice(event.target);
+    if(!choice) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    choice.input.mentionUser(choice.peerId, true);
+  }, true);
+}
+
+export function getMentionedMembers(roster: OrderRoster | undefined, entities: MessageEntity[] = []) {
+  if(!roster) return [];
+  const highlighted = new Set(entities.flatMap((entity) => {
+    if(entity._ === 'messageEntityMentionName') return [Number(entity.user_id).toPeerId(false)];
+    if(entity._ === 'inputMessageEntityMentionName' && entity.user_id._ === 'inputUser') {
+      return [Number(entity.user_id.user_id).toPeerId(false)];
+    }
+    return [];
+  }));
+  return roster.members.filter((member) => highlighted.has(roster.peerIds.get(member.id))).map(({id}) => id);
+}
