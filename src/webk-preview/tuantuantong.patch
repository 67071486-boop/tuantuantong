+      if(!isDisabled) continue;
+
+      if(isTile) control.disabled = true;
+      else control.tabIndex = -1;
+      control.setAttribute('aria-disabled', 'true');
+      control.setAttribute('data-preview-order-profile-action', '');
+    }
+  }
+
+  new MutationObserver((records) => {
+    const profiles = new Set<Element>();
+    for(const {target, addedNodes} of records) {
+      if(!addedNodes.length) continue;
+      const existing = target instanceof Element && target.closest(profileSelector);
+      if(existing) profiles.add(existing);
+      for(const node of addedNodes) {
+        if(!(node instanceof Element)) continue;
+        if(node.matches(profileSelector)) profiles.add(node);
+        node.querySelectorAll(profileSelector).forEach((profile) => profiles.add(profile));
+      }
+    }
+    profiles.forEach(disableOrderMemberActions);
+  }).observe(document.body, {childList: true, subtree: true});
