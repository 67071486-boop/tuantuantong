diff --git a/src/pages/localChatPreview/orderHistoryMode.ts b/src/pages/localChatPreview/orderHistoryMode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e87d335b795f4473ae9b3b81653bdf225eadf52b
--- /dev/null
+++ b/src/pages/localChatPreview/orderHistoryMode.ts
@@ -0,0 +1,203 @@
+import type {Message} from '@layer';
+import AppSelectPeers from '@components/appSelectPeers';
+import {getMiddleware} from '@helpers/middleware';
+import type {AppManagers} from '@lib/managers';
+import type {OrderConversation, OrderHistoryActionState, OrderMember} from './liveTransport';
+import appNavigationController from '@components/appNavigationController';
+import './orderHistoryMode.css';
+
+type HistoryOptions = {
+  peerId: PeerId;
+  order: OrderConversation;
+  members: Map<PeerId, OrderMember>;
+  managers: AppManagers;
+  hasMessages: boolean;
+  getMessage: (peerId: PeerId, mid: number) => Message.message | undefined;
+  activate: () => void;
+  subscribeActionState: (handler: (state: OrderHistoryActionState) => void) => void;
+  getRoleLabel: (member: OrderMember) => string;
+};
+
+export async function showOrderHistory(options: HistoryOptions) {
+  const {peerId, hasMessages, getMessage} = options;
+  const {roster, ready: rosterReady} = createRoster(options);
+  const action = createAction(options);
+  document.body.classList.add('tt-order-history');
+  appNavigationController.registerEscapeHandler(() => false);
+  // This embedded transcript must leave the browser Back button to the order page.
+  const pushItem = appNavigationController.pushItem;
+  appNavigationController.pushItem = function(item) {
+    if(item.type === 'popup') item.noHistory = true;
+    pushItem.call(this, item);
+  };
+  const {default: showChatPreviewPopup} = await import('@components/popups/chatPreview');
+  let observer: MutationObserver;
+  function openHistory(lastMsgId?: number) {
+    observer?.disconnect();
+    observer = new MutationObserver(mountPanels);
+    observer.observe(document.body, {attributes: true, attributeFilter: ['class'], childList: true, subtree: true});
+    showChatPreviewPopup({peerId, lastMsgId});
+    mountPanels();
+  }
+
+  function mountPanels() {
+    const popup = document.querySelector('.popup-chat-preview.active:not(.hiding) .popup-container');
+    const plate = popup?.querySelector('.chat-input-control .chat-input-plate-center');
+    if(!plate) return;
+    observer.disconnect();
+    popup.append(roster);
+    plate.append(action);
+  }
+
+  openHistory();
+
+  await Promise.all([rosterReady, new Promise<void>((resolve, reject) => {
+    const readySelector = '.popup-chat-preview.active:not(.hiding) .chat-preview ' + (hasMessages ? '.bubble[data-mid]' : '.bubbles');
+    const observer = new MutationObserver(checkReady);
+    const timeout = window.setTimeout(() => {
+      observer.disconnect();
+      reject(new Error('订单消息预览加载超时'));
+    }, 12_000);
+
+    function checkReady() {
+      if(!action.isConnected || !document.querySelector(readySelector)) return;
+      clearTimeout(timeout);
+      observer.disconnect();
+      resolve();
+    }
+
+    observer.observe(document.body, {attributes: true, attributeFilter: ['class'], childList: true, subtree: true});
+    checkReady();
+  })]);
+
+  let anchor: number | undefined;
+  let reopenTimer: number | undefined;
+  window.addEventListener('resize', () => {
+    clearTimeout(reopenTimer);
+    reopenTimer = window.setTimeout(() => openHistory(anchor), 120);
+  });
+
+  document.addEventListener('click', (event) => {
+    if(!(event.target instanceof Element)) return;
+    const preview = event.target.closest('.popup-chat-preview.active .chat-preview');
+    if(!preview) return;
+    const bubble = event.target.closest<HTMLElement>('.bubble[data-mid]');
+    if(!bubble) return;
+    const message = getMessage(peerId, Number(bubble.dataset.mid));
+    if(!message) return;
+
+    const image = event.target.closest('.attachment.media-container')?.querySelector<HTMLImageElement>('.media-photo[src^="blob:"]');
+    if(message.media?._ === 'messageMediaPhoto' && image?.src.startsWith('blob:' + location.origin + '/')) {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      showImage(image.src);
+      return;
+    }
+
+    if(message.reply_to_mid && event.target.closest('.reply')) {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      anchor = message.reply_to_mid;
+      const target = preview.querySelector(`.bubble[data-mid="${anchor}"]`);
+      if(target) target.scrollIntoView({block: 'center'});
+      else openHistory(anchor);
+    }
+  }, true);
+}
+
+function createRoster({members, managers, order, getRoleLabel}: HistoryOptions) {
+  const roster = document.createElement('aside');
+  roster.className = 'tt-order-history-roster';
+  roster.setAttribute('aria-label', '群成员');
+  const heading = document.createElement('header');
+  const title = document.createElement('h2');
+  const count = document.createElement('p');
+  title.textContent = order.title;
+  title.title = order.title;
+  count.textContent = `${order.members.filter(({left_at}) => !left_at).length} 位群成员`;
+  heading.append(title, count);
+  roster.append(heading);
+
+  const middleware = getMiddleware();
+  window.addEventListener('pagehide', (event) => {
+    if(!event.persisted) middleware.destroy();
+  });
+
+  const selector = new AppSelectPeers({
+    appendTo: roster,
+    managers,
+    middleware: middleware.get(),
+    peerType: [],
+    noInstantLoad: true,
+    noSearch: true,
+    noPlaceholder: true,
+    multiSelect: false,
+    meAsSaved: false,
+    withStories: false,
+    rippleEnabled: false,
+    onSelect: () => false,
+    getSubtitleForElement: (peerId) => {
+      const member = members.get(peerId);
+      const label = document.createElement('span');
+      label.textContent = [member.studio_name, getRoleLabel(member), member.left_at && '已退群'].filter(Boolean).join(' · ');
+      label.title = label.textContent;
+      return label;
+    }
+  });
+  return {roster, ready: selector.renderResultsFunc(Array.from(members.keys()))};
+}
+
+function createAction({order, activate, subscribeActionState}: HistoryOptions) {
+  const closed = order.can_join === false;
+  const isMember = order.is_member === true;
+  const action = document.createElement('div');
+  action.className = 'tt-order-history-action';
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.className = 'btn-primary btn-transparent text-bold chat-input-control-button chat-input-plate-button';
+  button.disabled = closed;
+  const status = document.createElement('span');
+  status.className = 'tt-order-history-action-status';
+  status.setAttribute('role', 'status');
+  action.append(button, status);
+
+  let busy = false;
+  function render(state: OrderHistoryActionState) {
+    busy = state.busy;
+    button.textContent = closed ? '群聊已结束' : isMember ?
+      busy ? '正在打开…' : '打开会话' : busy ? '正在加入…' : '加入会话';
+    button.setAttribute('aria-disabled', String(closed || busy));
+    status.textContent = state.error ?? '';
+  }
+
+  render({busy: false});
+  subscribeActionState(render);
+  button.addEventListener('click', () => {
+    if(closed || busy) return;
+    render({busy: true});
+    activate();
+  });
+  return action;
+}
+
+function showImage(source: string) {
+  const dialog = document.createElement('dialog');
+  const image = document.createElement('img');
+  const close = document.createElement('button');
+  dialog.className = 'tt-order-history-image';
+  dialog.setAttribute('aria-label', '图片预览');
+  image.src = source;
+  image.alt = '聊天图片';
+  close.type = 'button';
+  close.className = 'btn-icon';
+  close.textContent = '×';
+  close.setAttribute('aria-label', '关闭图片预览');
+  close.addEventListener('click', () => dialog.close());
+  dialog.addEventListener('click', (event) => {
+    if(event.target === dialog) dialog.close();
+  });
+  dialog.addEventListener('close', () => dialog.remove(), {once: true});
+  dialog.append(image, close);
+  document.body.append(dialog);
+  dialog.showModal();
+}
