+  if(isH5 && installH5ListControls(api.closeFromList)) api.reportListControlsReady();
+  if(openWorkerDirectory) installWorkerDirectory(isH5, openWorkerDirectory);
+  installLiveSearchLayout(() => appImManager.chat.topbar.setFloating());
+  refreshOrderMediaControls = installOrderMediaActions(() => {
+    const peerId = appImManager.chat.peerId;
+    const conversation = conversations.get(peerId);
+    if(!conversation) return;
+    const isOrder = conversation.kind === 'order';
+    return {
+      peerId,
+      isOrder,
+      canPin: isOrder && canPinMessage(peerId),
+      members: isOrder ? conversation.members : [self, conversation.peer],
+      search: (query, before, filters) => api.search(conversation.id, query, before, filters),
+      openMessage: (id, fromViewer) => {
+        if(appImManager.chat.peerId !== peerId) return;
+        if(fromViewer && mediaSizes.isMobile) void appSidebarRight.toggleSidebar(false);
+        appImManager.chat.resetSearch();
+        void appImManager.setInnerPeer({peerId, lastMsgId: id}).catch(reportSendFailure);
+      }
+    };
+  });
+  document.title = '团团通内部通讯';
+  api.changed.addEventListener('change', synchronize);
+  let navigation = 0;
+  api.connectNavigation(async(id) => {
+    const serial = ++navigation;
+    try {
+      if(!peerByConversation.has(id)) await refreshDialogs();
+      if(serial !== navigation) return;
+      const peerId = peerByConversation.get(id);
+      if(peerId !== undefined) await appImManager.setInnerPeer({peerId});
+      else toast('未找到该会话');
+    } catch(error) {
+      if(serial === navigation) reportSendFailure(error);
+    }
+  });
+  window.addEventListener('online', synchronize);
+  void synchronize();
+}
