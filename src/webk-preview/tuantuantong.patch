@@ -0,0 +1,16 @@
+import {defineConfig, mergeConfig} from 'vite';
+import base from './vite.config';
+
+const port = Number(process.env.TT_WEBK_PREVIEW_PORT || 4180);
+
+export default defineConfig(mergeConfig(base, {
+  server: {
+    host: '127.0.0.1',
+    port,
+    strictPort: true,
+    forwardConsole: false,
+    headers: {
+      'Content-Security-Policy': `connect-src 'self' ws://127.0.0.1:${port} blob:; worker-src 'self' blob:`
+    }
+  }
+}));
