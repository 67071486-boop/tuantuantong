+import type {Dialog, DialogFilter, Message} from '@layer';
+import {seedMirror, mockManagers} from '@components/popupSandbox/bootstrapState';
+import {
+  CONTACT_PEER_ID, GROUP_PEER_ID, PREMIUM_PEER_ID, SELF_PEER_ID,
+  contactUser, dialogs, groupChat, makeMessage, premiumUser
+} from '@components/popupSandbox/fixtures';
+import {installSandboxEnvironment} from '@components/popupSandbox/environment';
+import appChatBackground from '@components/chat/bubbles/chatBackground';
+import {joinDeepPath} from '@helpers/object/setDeepProperty';
+import {SliceEnd} from '@helpers/slicedArray';
+import apiManagerProxy from '@lib/apiManagerProxy';
+import rootScope from '@lib/rootScope';
+import {ConnectionStatus} from '@lib/mtproto/connectionStatus';
+import getHistoryStorageKey from '@appManagers/utils/messages/getHistoryStorageKey';
+import {setAppSettingsSilent} from '@stores/appSettings';
+import {_useHistoryStorage} from '@stores/historyStorages';
+import {bootstrapIm} from './bootstrapIm';
+import {installChineseLanguage} from './localChatPreview/installChineseLanguage';
+import {installPreviewMenus} from './localChatPreview/installPreviewMenus';
+import orderGroupAvatar from './localChatPreview/order-group-avatar.png';
+
+type DemoDialog = Dialog.dialog & {index_0: number, topMessage?: Message.message};
+
+const now = Math.floor(Date.now() / 1000);
+let nextId = 10000;
+const activePeers = [GROUP_PEER_ID, CONTACT_PEER_ID, PREMIUM_PEER_ID, SELF_PEER_ID];
+const chats = new Map<PeerId, DemoDialog>();
+const histories = new Map<PeerId, Message.message[]>();
+
+function addMessage(peerId: PeerId, text: string, fromId: PeerId, date = Math.floor(Date.now() / 1000)) {
+  const dialog = chats.get(peerId);
+  const history = histories.get(peerId);
+  if(!dialog || !history) return;
+
+  const outgoing = fromId === SELF_PEER_ID;
+  const message = makeMessage({
+    peerId,
+    peer_id: dialog.peer,
+    mid: ++nextId,
+    fromId,
+    from_id: {_: 'peerUser', user_id: String(fromId)},
+    pFlags: outgoing ? {out: true} : {},
+    message: text,
+    date
+  });
+  const globalStorage = apiManagerProxy.getGlobalHistoryMessagesStorage();
+  const storageKey = apiManagerProxy.getHistoryMessagesStorage(peerId);
+  for(const storage of new Set([storageKey, globalStorage])) {
+    seedMirror('messages', joinDeepPath(storage, message.mid), message);
+  }
+  history.unshift(message);
+  const [state, update] = _useHistoryStorage(getHistoryStorageKey({type: 'history', peerId}));
+  state.history.insertSlice(history.map(({mid}) => mid));
+  state.history.first.setEnd(SliceEnd.Both);
+  update({count: history.length, _maxId: message.mid});
+  dialog.topMessage = message;
+  dialog.top_message = message.mid;
+  dialog.read_inbox_max_id = message.mid;
+  dialog.read_outbox_max_id = message.mid;
+  dialog.index_0 = date * 65536 + message.mid;
+  return {message, storageKey};
+}
+
+export async function startLocalChatPreview() {
+  if(new URLSearchParams(location.search).get('live') === '1') {
+    const {startLiveChat} = await import('./localChatPreview/liveChat');
+    await startLiveChat();
+    return;
+  }
+
+  groupChat.title = '订单-20261116000000000086';
+  groupChat.photo = {_: 'chatPhoto', pFlags: {}, photo_id: '888001001', dc_id: 2};
+  contactUser.first_name = '小林';
+  contactUser.last_name = '';
+  premiumUser.first_name = '阿洛';
+  premiumUser.last_name = '';
+  groupChat.participants_count = 3;
+
+  for(const peerId of activePeers) {
+    const original = dialogs.find((dialog) => dialog.peerId === peerId) as DemoDialog;
+    const peer: DemoDialog['peer'] = peerId === GROUP_PEER_ID ?
+      {_: 'peerChat', chat_id: String(groupChat.id)} :
+      original.peer;
+    chats.set(peerId, {...original, peer});
+    histories.set(peerId, []);
+  }
+
+  addMessage(SELF_PEER_ID, '团团通原版界面预览用的本地备忘。', SELF_PEER_ID, now - 3400);
+  addMessage(PREMIUM_PEER_ID, '这单我已经看到了，今晚能交。', PREMIUM_PEER_ID, now - 3000);
+  addMessage(CONTACT_PEER_ID, '发单前我先核对一下客户要求。', CONTACT_PEER_ID, now - 2400);
+  addMessage(CONTACT_PEER_ID, '好，核对完发到订单群里。', SELF_PEER_ID, now - 2300);
+  addMessage(GROUP_PEER_ID, '订单已经指派给阿洛，有进度就在群里同步。', CONTACT_PEER_ID, now - 2200);
+  addMessage(GROUP_PEER_ID, '收到，已经开打。', PREMIUM_PEER_ID, now - 2060);
+  addMessage(GROUP_PEER_ID, '打完把结算截图发到群里就行。', SELF_PEER_ID, now - 1990);
+  addMessage(GROUP_PEER_ID, '第一局打完了，预计今晚交单。', PREMIUM_PEER_ID, now - 840);
+  chats.get(PREMIUM_PEER_ID).unread_count = 1;
+
+  const getDialog = (peerId: PeerId) => chats.get(peerId);
+  const groupFull = {
+    _: 'chatFull',
+    id: groupChat.id,
+    pFlags: {},
+    participants: {
+      _: 'chatParticipants',
+      chat_id: groupChat.id,
+      participants: [SELF_PEER_ID, CONTACT_PEER_ID, PREMIUM_PEER_ID].map((user_id) => ({
+        _: 'chatParticipant', user_id, inviter_id: SELF_PEER_ID, date: now
+      })),
+      version: 1
+    }
+  };
+  const allChats: DialogFilter.dialogFilter & {localId: number} = {
+    _: 'dialogFilter',
+    id: 0,
+    localId: 0,
+    title: {_: 'textWithEntities', text: '', entities: []},
+    pFlags: {},
+    exclude_peers: [],
+    include_peers: [],
+    pinned_peers: []
+  };
+  const getDialogs = ({filterId = 0, query = ''} = {}) => {
+    const found = filterId === 0 ? Array.from(chats.values()).filter((dialog) =>
+      !query || dialog.topMessage?.message.includes(query)
+    ).sort((a, b) => b.index_0 - a.index_0) : [];
+    return {dialogs: found, count: found.length, isEnd: true};
+  };
+  mockManagers.override({
+    appAvatarsManager: {
+      loadAvatar: (peerId: PeerId) => peerId === GROUP_PEER_ID ? orderGroupAvatar : undefined
+    },
+    apiManager: {
+      getPeerColors: () => ({colors: []}),
+      getPeerProfileColors: () => ({colors: []}),
+      getBaseDcId: () => 2
+    },
+    rootScope: {
+      getPremium: () => false,
+      getConnectionStatus: () => ({'NET-2': {status: ConnectionStatus.Connected}})
+    },
+    filtersStorage: {
+      getDialogFiltersToStart: () => [allChats],
+      getFilter: () => allChats
+    },
+    appBusinessManager: {getBotConnectionReviews: () => []},
+    appAccountManager: {getUnconfirmedAuthorizations: () => []},
+    appReactionsManager: {getSavedReactionTags: () => []},
+    appStickersManager: {getFeaturedStickers: () => []},
+    appStoriesManager: {
+      getAllStories: () => ({state: '', peer_stories: [], pFlags: {}}),
+      getListPositions: () => [],
+      getPeerStories: (peerId: PeerId) => ({peer: getDialog(peerId)?.peer, stories: []}),
+      getPinnedStories: () => ({count: 0, stories: []})
+    },
+    appEmojiManager: {prepareAndSearchEmojis: () => []},
+    appThemesManager: {getThemes: () => []},
+    appProfileManager: {
+      getPeerTypings: () => [],
+      getChatFull: () => groupFull,
+      getProfileByPeerId: (peerId: PeerId) => peerId === GROUP_PEER_ID ? groupFull : {
+        _: 'userFull', id: peerId, pFlags: {}, settings: {_: 'peerSettings', pFlags: {}}
+      },
+      getOnlines: () => 0
+    },
+    appUsersManager: {getContacts: () => [contactUser, premiumUser]},
+    appDraftsManager: {getDraft: () => undefined},
+    appPeersManager: {
+      isAnyGroup: (peerId: PeerId) => peerId === GROUP_PEER_ID,
+      isLikeGroup: (peerId: PeerId) => peerId === GROUP_PEER_ID,
+      isChannel: () => false,
+      isBot: () => false,
+      isContact: (peerId: PeerId) => peerId === CONTACT_PEER_ID || peerId === PREMIUM_PEER_ID,
+      getPeerId: (peer: DemoDialog['peer']) => peer._ === 'peerChat' ?
+        -Number(peer.chat_id) :
+        peer._ === 'peerUser' ? Number(peer.user_id) : -Number(peer.channel_id)
+    },
+    dialogsStorage: {
+      getDialogs,
+      getDialogOnly: getDialog,
+      getAnyDialog: getDialog,
+      getCachedDialogs: () => getDialogs().dialogs,
+      getDialogIndex: (peerId: PeerId) => getDialog(peerId)?.index_0,
+      getDialogIndexKeyByFilterId: () => 'index_0',
+      getFolderUnreadCount: () => 0,
+      getForumUnreadCount: () => ({count: 0, hasUnmuted: false})
+    },
+    appMessagesManager: {
+      canSendToPeer: (peerId: PeerId) => chats.has(peerId),
+      getEphemeralHistory: () => [],
+      getSearchCounters: (_peerId: PeerId, filters: unknown[]) => filters.map((filter) => ({filter, count: 0})),
+      getDialogOnly: getDialog,
+      isDialogUnread: (dialog: DemoDialog) => dialog.unread_count > 0,
+      getMessageByPeer: (peerId: PeerId, mid: number) => histories.get(peerId)?.find((message) => message.mid === mid),
+      getHistory: ({peerId, inputFilter}) => {
+        const messages = inputFilter ? [] : histories.get(peerId) ?? [];
+        return {
+          count: messages.length,
+          history: messages.map(({mid}) => mid),
+          messages,
+          isEnd: {both: true, top: true, bottom: true}
+        };
+      },
+      getPinnedMessagesMaxId: () => 0,
+      getPinnedMessage: () => ({maxId: 0, count: 0}),
+      sendText: ({peerId, text}) => {
+        if(!text?.trim()) return;
+        const entry = addMessage(peerId, text, SELF_PEER_ID);
+        if(!entry) return;
+        rootScope.dispatchEvent('history_append', entry);
+        rootScope.dispatchEvent('dialogs_multiupdate', new Map([[peerId, {dialog: getDialog(peerId)}]]));
+      }
+    }
+  });
+
+  setAppSettingsSilent('notifications', 'suggested', true);
+  rootScope.premium = false;
+  await installSandboxEnvironment();
+  await installChineseLanguage();
+  installPreviewMenus();
+  appChatBackground.attach();
+  appChatBackground.setBackground({transition: 'instant'});
+  await bootstrapIm(mockManagers.managers);
+  document.title = 'Telegram Web K · 本地聊天预览';
+  if(new URLSearchParams(location.search).get('list') !== '1') {
+    const {default: appImManager} = await import('@lib/appImManager');
+    await appImManager.setPeer({peerId: GROUP_PEER_ID}, false);
+  }
+}
diff --git a/src/pages/localChatPreview/composerImages.ts b/src/pages/localChatPreview/composerImages.ts
