+  const openBtnMenu = contextMenuController.openBtnMenu.bind(contextMenuController);
+  const deleteIcon = getIconContent('delete');
+  contextMenuController.openBtnMenu = (menu, onClose, trigger, activateFocus) => {
+    const isMainMenu = trigger?.matches('.sidebar-tools-button');
+    const isConversationMenu = trigger?.closest('.chat-utils');
+    const dialogPeerId = trigger?.matches('.chatlist-chat[data-peer-id]') ?
+      Number(trigger.dataset.peerId).toPeerId(false) : undefined;
+    const isManagedDialog = order && dialogPeerId !== undefined && order.hasConversation(dialogPeerId);
+    if(isManagedDialog) {
+      if(!menu.querySelector(':scope > .btn-menu-item[data-preview-remark]')) {
+        appendButtonMenuItems(menu, [{
+          icon: 'edit',
+          className: 'preview-chat-remark',
