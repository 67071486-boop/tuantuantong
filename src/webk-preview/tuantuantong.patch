diff --git a/src/pages/localChatPreview/orderHistoryMode.css b/src/pages/localChatPreview/orderHistoryMode.css
new file mode 100644
index 0000000000000000000000000000000000000000..20ed9cb21c748316103e4a271f58039d61525ae4
--- /dev/null
+++ b/src/pages/localChatPreview/orderHistoryMode.css
@@ -0,0 +1,174 @@
+.tt-order-history {
+  --tt-order-roster-width: clamp(10rem, 28vw, 17rem);
+}
+
+.tt-order-history #page-chats {
+  visibility: hidden;
+}
+
+.tt-order-history .popup-chat-preview {
+  background: transparent;
+  visibility: visible;
+}
+
+.tt-order-history .popup-chat-preview .popup-container {
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+.tt-order-history .chat-preview-wrapper {
+  inset-inline-start: var(--tt-order-roster-width);
+}
+
+.tt-order-history .tt-order-history-roster {
+  position: absolute;
+  inset-block: 0;
+  inset-inline-start: 0;
+  display: flex;
+  flex-direction: column;
+  width: var(--tt-order-roster-width);
+  color: var(--primary-text-color);
+  background: var(--surface-color);
+  border-inline-end: 1px solid var(--border-color);
+}
+
+.tt-order-history-roster header {
+  padding: 1rem .875rem .625rem;
+}
+
+.tt-order-history-roster h2 {
+  overflow: hidden;
+  margin: 0;
+  font-size: 1rem;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.tt-order-history-roster header p {
+  margin: .25rem 0 0;
+  color: var(--secondary-text-color);
+  font-size: .875rem;
+}
+
+.tt-order-history-roster .selector {
+  flex: 1;
+  min-height: 0;
+}
+
+.tt-order-history-roster .row[data-peer-id] {
+  padding-inline: 3.875rem .5rem !important;
+  cursor: default;
+}
+
+.tt-order-history-roster .dialog-title-details {
+  display: none;
+}
+
+.tt-order-history-roster .row .dialog-subtitle {
+  height: auto;
+}
+
+.tt-order-history-roster .row-subtitle {
+  white-space: normal !important;
+  overflow-wrap: anywhere;
+}
+
+.tt-order-history .chat.chat-preview {
+  inset: 0;
+  --chat-topbar-height: 0px;
+  --chat-input-height: 3.25rem;
+  --page-chats-padding: .625rem;
+  --tt-history-plate-room: calc(var(--chat-input-height) + var(--page-chats-padding) + .75rem);
+}
+
+/* Match the scroll room to the visible plate instead of the native preview's fixed spacers. */
+.tt-order-history .chat-preview .bubbles-padding-top {
+  height: var(--page-chats-padding) !important;
+}
+
+.tt-order-history .chat-preview .bubbles-padding-bottom {
+  height: var(--tt-history-plate-room) !important;
+}
+
+.tt-order-history .chat-preview .bubbles-inner {
+  min-height: calc(100% - var(--page-chats-padding) - var(--tt-history-plate-room));
+}
+
+.tt-order-history .chat-preview :is(.chat-topbar, .topbar),
+.tt-order-history .chat-preview .chat-input > :not(.chat-input-container),
+.tt-order-history .chat-preview .chat-input-container > :not(.chat-input-control),
+.tt-order-history .chat-preview .chat-input-plate-center > :not(.tt-order-history-action) {
+  display: none !important;
+}
+
+.tt-order-history .chat-preview .chat-input {
+  display: flex !important;
+  position: absolute;
+  inset-inline: 0;
+  bottom: var(--page-chats-padding);
+  z-index: 4;
+  padding-inline: var(--page-chats-padding);
+}
+
+.tt-order-history .chat-preview .chat-input-control {
+  border-radius: calc(var(--chat-input-height) / 2);
+}
+
+.tt-order-history .tt-order-history-action {
+  width: 100%;
+}
+
+.tt-order-history-action button[aria-disabled="true"] {
+  color: var(--secondary-text-color);
+  cursor: default;
+}
+
+.tt-order-history-action-status:not(:empty) {
+  position: absolute;
+  inset-inline: .25rem;
+  bottom: calc(100% + .375rem);
+  padding: .375rem .75rem;
+  border-radius: .75rem;
+  background: var(--surface-color);
+  color: var(--danger-color);
+  text-align: center;
+  overflow-wrap: anywhere;
+}
+
+.tt-order-history .chat-preview .bubble :is(.reply, .attachment.media-container) {
+  pointer-events: auto;
+  cursor: pointer;
+}
+
+.tt-order-history-image[open] {
+  display: grid;
+  place-items: center;
+  min-width: 4rem;
+  min-height: 4rem;
+  max-width: calc(100vw - 2rem);
+  max-height: calc(100vh - 2rem);
+  padding: 0;
+  border: 0;
+  border-radius: .5rem;
