# 环境变量模板
#
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   cp .env.example .env
#
# 纪律：
#   - 本文件只放「变量名 + 说明 + 假值」，永远不放真实密钥。
#   - 每新增一个变量，同步更新 README.md 的「环境变量」表。
#   - 变量含义与启动方式见 README.md「环境变量」「快速开始」两节。

# ── Django ────────────────────────────────────────────
# 生产必须换成随机长串；本地可用任意非空假值
DJANGO_SECRET_KEY=change-me
# 调试开关：development 用 true，生产必须 false
DJANGO_DEBUG=true
# 逗号分隔；前导点表示任意子域（.test.local 放行 *.test.local）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.test.local
# 分布式租户的鸡蛋铺回调域；未登记者继续沿用自己的站点域名。
JIDANPU_CALLBACK_HOSTS={}
# CSRF 受信来源，逗号分隔，支持通配子域。生产示例：https://*.example.com
# ⚠️ `localhost` / `127.0.0.1` / 局域网 IP（手机走 `pnpm dev:lan`）是**三个不同的来源**
#    （Django 拿浏览器发的 `Origin` 逐字比，不做别名归一）。**少一个就少一个能登录的地址**，
#    症状是登录反复提示「会话校验已刷新，请重试」或「无法获取 CSRF 令牌」——因为前端补领令牌
#    走的是 GET（不受来源校验），补领"成功"了但重放仍 403（2026-09-20 实测）。
#    加了之后**必须重启后端**：`.env` 只在启动时读一次。局域网 IP 变了也要重新加。
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ⚠️ 刻意**注释掉**（与 `TENANT_FLEET_FILE` 同一形态）：默认行为 = **不设**这个键 = `config.urls`。

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_DB=tuantuantong
POSTGRES_USER=tuantuantong
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 共用网页试点仅给网页进程设置。填写权限为 0600 的 JSON 文件绝对路径，独立部署与后台任务留空。
# 文件格式和验收：docs/specs/2026-11-18-shared-web-pilot.md。
# TT_SHARED_WEB_ROUTES_FILE=
# 平台发单独立出口的租户路由文件，格式和隧道配置见 docs/RUNBOOK.md §3.0.3。
# TT_PLATFORM_EGRESS_ROUTES_FILE=
# 订单财务直连：仅开启登记工作室，文件为绝对路径且仅属主可读。
# TT_ORDER_FINANCE_BROWSER_FILE=
# 仅订单财务直连进程配置。逗号分隔的租户 schema 清单，留空关闭读请求的 60 秒连接复用。
# TT_ORDER_FINANCE_REUSE_SCHEMAS=
# 与后台任务机成对配置。默认保留即时导出。
# TT_ORDER_FINANCE_ASYNC_EXPORTS=0
# TT_ORDER_FINANCE_ASYNC_EXPORT_SCHEMAS=
# 连接复用（长连接）秒数。**默认 0 = 每请求一条连接、用完就关（今天的行为）**。
#   本机开发留空/写 0：连的是本地库，重连开销可以忽略，开了只多占连接、没有收益。
#   生产（腾讯云托管实例）写 **60**。依据（2026-09-24 真机实测）：应用机 → 托管库走云联网，
#   **ping 0.13 ms、TCP 建连约 2.7 ms**，一次新连接还要多付 SCRAM 认证与若干次往返；
#   不开则每条请求都重连一次，而一个页面通常并发若干 API 调用 ⇒ 每页白付几十毫秒。
#   连接数够不够：实例 `max_connections` 实测 **2048**、当时占用 **14** ⇒
#   2 个 gunicorn worker 各持一条毫无压力。
POSTGRES_CONN_MAX_AGE=0
# 连接验活开关，**与上面的长连接成对用**：持连接就会遇到"服务端把空闲连接掐了"
#   （托管实例重启、网络抖动、空闲超时都会），Django 在请求开始时先验一次、失效就换一条。
#   缺了它，症状是零星的 `server closed the connection unexpectedly` 500 —— **看起来像代码 bug**，
#   实际是运维现象。默认 true，只有排查时才关。
POSTGRES_CONN_HEALTH_CHECKS=true

# ── 每租户独立 database（B 档隔离，D-0137）────────────
# 一租户 = 一个 PostgreSQL database + 一个**同名角色**。库名与角色名一律
# `{TENANT_DB_PREFIX}{schema_name}` **派生**、不落库（存进清单必漂移）；
# 多环境共用同一集群时换前缀防撞名。
TENANT_DB_PREFIX=tt_
# 供给（建库/建角色）与巡检用的运维身份。
# ⛔ **实际要求是超管**（非超管方案未实现未测，见 docs/RUNBOOK.md §2.5.1）：
#    `CREATEDB + CREATEROLE` **不够**（跑不了已实现的供给 SQL），也不要拿应用角色当供给身份
#    （它**没有 CREATEROLE**，实测报错 `permission denied to create role`）。
#    ⚠️ 别把「有 CREATEDB」套错身份：本机**主检出的应用角色** `tt_dev` 是 `rolcreatedb=f`
#    （租户角色**故意**没有 CREATEDB——它只对自己的库有 `CONNECT`）；**有** CREATEDB 的是
#    **测试身份** `tuantuantong`——Django 测试运行器要建/删测试库 ⇒ 跑测试才要
#    `POSTGRES_USER=tuantuantong`（见 docs/RUNBOOK.md §2.5.1）。⛔ 不要给租户角色补 CREATEDB。
# ⚠️ 这个身份**能连每一个租户库** ⇒ **绝不能出现在任何租户服务器的 `.env` 里**
#    （租户服务器上请删掉这三行）。
# 本机 `postgres` 走 TCP 免密（pg_hba 为 trust），所以本地填什么都行；生产填真实口令。
# 回退规则：只有**键不存在**时才回退到上面的 POSTGRES_USER / POSTGRES_PASSWORD；
#    写成 `POSTGRES_ADMIN_USER=`（空值）**不会**回退，会真的用空用户名去连。
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
# 供给时连的库（建库建角色在它上面执行）。
POSTGRES_ADMIN_DB=postgres

# ── 车队清单（运维库存；**不是**权威租户目录）──────────
# 清单文件路径。**不设就用默认值** `<仓库根>/fleet.json`（与 `src/` 同级）。
# ⚠️ 清单是**运维库存**（哪个租户在哪个库），**不是**权威租户目录——权威目录仍是各租户库
#    `public` 里的 `platform_tenant` / `platform_domain`；两者是否一致由**平台侧**的巡检命令
#    （独立项目 `../ttt-platform` 的 `fleet_status`）显式对账，本清单不参与合并。
# 真实 `fleet.json` **不进 git**（仓库只提交 `fleet.example.json`，形状照它抄）。
# 只有把清单放到别处时才解开下面这行；请填**绝对路径**（相对路径按启动时的工作目录解析，
# 从 `src/` 启动会把 `fleet.json` 解析到 `src/` 下，而不是仓库根）。
# TENANT_FLEET_FILE=/etc/tuantuantong/fleet.json

# ── 对标物鸡蛋铺（只读调研用）────────────────────────
# 用途：让任何会话都能复现对标物取数，不必每次重新要凭据。
# 取数方法、红线与证据等级见 docs/JIDANPU-REFERENCE.md。
# 该账号为受限权限账号（89 条路由里 68 条 nopermission），细则见该文档 §4。
JIDANPU_TENANT_URL=https://suqing.jidanpu.com
JIDANPU_ACC=change-me
JIDANPU_PWD=change-me

# ── 阿奇索（Agiso）开放平台（平台级密钥，全平台一套，不入库）──
# 用途：录单页「填来源单号自动带出价格与买家昵称」的数据源。
# 取法：open.agiso.com 创建【电商业务】应用 → 拿 AppId/AppSecret。
# ⚠️ AGISO_APP_SECRET **不下发给租户**（页面上不会出现、日志里也不会出现）；
#    AGISO_APP_ID 则**只读预填给租户**（对标把统一 AppId 预填给租户看），租户不可改。
# 两者任一缺失时读单回业务码 1015（来源未绑定、授权码为空同样回 1015）；不影响服务启动。
AGISO_APP_ID=change-me
AGISO_APP_SECRET=change-me
# 调用基址（默认已实测坐实；只有对着沙箱/联调环境时才需要改）
AGISO_API_BASE=https://gw-api.agiso.com/aldsIdle

# ── 闲管家（闲鱼店铺管理平台）开放平台 ──
# ⚠️ **这里没有 AppKey/AppSecret**，这是与上面阿奇索那组最大的区别：
#    闲管家的应用由**每个租户自己**在闲管家开放平台创建，凭据按租户存在租户 schema 的
#    `XgjShopBinding` 表里（页面上填、只写不读）。平台级只需要一个基址开关。
# 取法：闲管家开放平台创建【自研应用】→ 拿 AppKey/AppSecret → 租户在
#    「第三方平台 → 闲管家店铺对接」页填进去。
XGJ_API_BASE=https://open.goofish.pro
# 订单管理页「同步收款」的限速（笔/秒；默认 2，业务上限 3）。
# 只影响手动任务：每次上游调用之间按 1/QPS 秒等待（闲管家按次计费）。
XGJ_RECEIPT_SYNC_QPS=2
# 自动发货节流队列的最小间隔（秒；默认 1.0，D-0358）：worker 每发完一条睡这一档
# 再取下一条（web 2 个进程 ⇒ 全机最坏 2 笔/秒）。两层口径：**字面**写坏（非数字）
# 由 `env.float` 启动即抛（与 `env.int` 同风格——配置写坏 = 服务起不来，显式取舍）；
# `≤ 0` / NaN 是**运行期**回落 1.0 并记 warning（`xgj_ship._ship_min_interval`，节流不许静默失效）。
XGJ_SHIP_MIN_INTERVAL=1.0

# 上家收款同步（D-0359）：相邻两单间隔(秒) / 查无放弃阈值 / 夜间完成时间窗(天)
RECEIPT_SYNC_INTERVAL_SECONDS=1.5
RECEIPT_SYNC_NOTFOUND_GIVEUP=3
RECEIPT_SYNC_WINDOW_DAYS=90

# ── 上下游订单互通（下家侧）：我方**对外可达**的基址 ──
# ⚠️ **生产必填、且必须是 `https://<租户域名>`**（每个租户各配各的）：生产由 nginx 终止 TLS、
#    gunicorn 侧说 http，而本仓**没有** `SECURE_PROXY_SSL_HEADER` ⇒ `request.scheme` 恒为 http。
#    握手时这个值会交给上家、成为它后来**推送**用的地址 ⇒ 若留空按请求推导，交出去的是
#    `http://…`，推送会打到 nginx 的 80 → 301，而 httpx 默认不跟随重定向 ⇒ **下行推送永远失败**。
#    本地开发可留空（按请求推导兜底）；形态由 `src/tests/test_peer_sync_local_base_url.py` 守。
# 详见 docs/specs/2026-09-25-upstream-downstream-order-sync-design.md §14-R13（裁决 R12）。
PEER_SYNC_LOCAL_BASE_URL=
# ── 媒体文件存储（图片存储线，spec §6 / §12）──────────
# 存储后端开关：`local`（本机 + CI，**默认**，不联网、不需要云凭据）/ `cos`（生产）。
# ⚠️ 本机与 CI 一律留 `local`：跑测试不该需要云凭据，也不该联网。
MEDIA_STORAGE_BACKEND=local
# 下面四项只在 `MEDIA_STORAGE_BACKEND=cos` 时用得上；**本机留空**。
# ⚠️ 桶名必须**逐字复制**（形状 `<名字>-<10 位 APPID>`，目视截图极易少读一位，
#    少一位会一路 `NoSuchBucket`——对不存在的桶 COS 回 404 而不是 403，见 spec §12.3）。
# ⛔ 密钥只写进你自己的 `.env`（不进 git）；本文件永远留空。
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ── App 安装包分发（下载页 + COS **公开读**桶，2026-10-21）──────────
# 只在**发版机**上给 `deploy/app-release/publish.py` 用；本机与 CI 可留空（跑测试不需要）。
# ⚠️ 这个桶是**公有读**、只放 apk 与 releases.js，⛔ 与上面存头像/截图的私有桶**不是同一个**。
# 建桶步骤与 CDN 接法见 docs/RUNBOOK.md「打手 App 安装包分发」。
APP_COS_BUCKET=tt-app-1440679012
APP_COS_REGION=ap-shanghai
# 密钥默认复用上面的 COS_SECRET_ID / COS_SECRET_KEY（该子账号需对本桶有读写权限）；
# 要给分发单独开子账号时填这两项。
APP_COS_SECRET_ID=
APP_COS_SECRET_KEY=
# 安装包外链前缀。留空 = 走 COS 默认域名；接了 CDN 之后填 CDN 域名（如 https://dl.suqing.chat/apk/），
# 改完**重跑一次 publish** 清单里的 base 才会换（下载页不用重新发版）。
APP_COS_BASE_URL=
# Android 正式包公开可下载后再设置最低版本号，0 关闭强更。
APP_ANDROID_MIN_VERSION_CODE=0

# ── 请求耗时埋点（性能分析线）──────────────────────────
# 用途：每次 API 请求折成一条「谁 / 什么时候 / 哪个接口 / 多久」的汇总行，供
#   「开放平台 → 性能分析」页查看（只对账号管理员开放）。口径见
#   docs/plans/2026-10-04-request-metrics.md §5。
# REQUEST_METRICS_ENABLED：总开关，**默认 true（开）**。关掉即整段埋点不写库
#   （临时排障 / 压测时才关；常关等于这个功能不存在）。
# REQUEST_METRICS_SLOW_MS：慢请求阈值，**默认 500**（毫秒）。耗时**严格大于**它的请求
#   **额外**再写一条 slow 行（逐条留精确耗时）；其余按整点汇总，不受这个阈值影响。
REQUEST_METRICS_ENABLED=true
REQUEST_METRICS_SLOW_MS=500

# ── 鸡蛋铺「老回调地址」归哪个租户（机器级例外）──────────────
# 用途：平台侧那条**旧**回调地址（`https://callback.suqing.chat/jidanpu/v1/notify`，
#   就一个固定路径、报文里**没有回调码**）目前指向 kexing 那台机器；本变量点名
#   「这条老地址收到的回调归哪个租户」，让这台机器上的那个租户也能用上这些回调
#   （否则它们只被登记、不会改任何订单）。
# ⚠️ **默认留空 = 整条路关着**（保持原状）；只有**老地址确实指向它**的那台机器才填。
# ⚠️ 值必须是**本机的租户 schema 名**（全等匹配），例：kexing。
# ⚠️ 这是**例外不是通用做法**：「老地址 → 哪个租户」是**机器级**事实（那台机的 nginx 才把
#   这条路径转给接收器）。第二台机器也要服务老地址时，必须先想清这套映射再改。
#   细节见 docs/RUNBOOK.md 的「鸡蛋铺官方 API 对接线」一节。
JIDANPU_LEGACY_CALLBACK_TENANT=

# ── 打手 App（代代通）· 短信 / 支付 / 押金闸（D-0269，2026-10-19）──────
# ⚠️ 这一组是**逐租户**的开关与凭据：哪台租户机要开 App 线，就配哪台的 `.env`。
# SMS_BACKEND：`console` = 验证码只打日志（开发/测试）；`tencent` = 真发。
#   ⚠️ **生产必须 tencent**：DEBUG=False 时 console 会**直接报错**（不会静默地"发出去"）。
SMS_BACKEND=console
# 腾讯云短信（云 API 密钥，不是短信控制台的 App Key；SecretId 以 AKID 开头）。
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
# 短信应用 ID（控制台「应用管理」里的 SdkAppId，形如 1400xxxxxx）。
SMS_TENCENT_SDK_APP_ID=
# 签名**内容**（如「代代通」），⛔ 不是签名 ID；模板 ID 是数字串。
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=
SMS_TENCENT_REGION=ap-guangzhou
# Jeepay 聚合支付（业务方已有实例）。密钥在 Jeepay 商户后台，⛔ 不进 git。
JEEPAY_GATEWAY=https://pay.suqing.chat
JEEPAY_MCH_NO=
JEEPAY_APP_ID=
JEEPAY_KEY=
# 支付回调地址（公网可达，Jeepay 主动 POST）。
JEEPAY_NOTIFY_URL=
# 微信小程序（「码上来」）：AppID / AppSecret 只用于 code2session 换 openid。
#   ⚠️ 小程序 openid 只属于这个 AppID，公众号那串不能复用；留空 = 小程序支付未配置。
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
# Jeepay 后台「小程序支付」那个应用自己的 appId / appKey（商户号沿用 JEEPAY_MCH_NO）。
#   ⚠️ 与公众号那条应用的 JEEPAY_APP_ID / JEEPAY_KEY **不是同一对**；留空 = 小程序支付未配置。
JEEPAY_MINI_APP_ID=
JEEPAY_MINI_APP_KEY=
#: 小程序应用的 Jeepay 商户号（空 = 与 JEEPAY_MCH_NO 同一个）
JEEPAY_MINI_MCH_NO=
# Jeepay 支付宝代付的两个通道枚举。属于「那台 Jeepay 实例配了什么」⇒ 实测后改这里，
# ⛔ 不改代码（计划 §10 步骤 0）。ifCode 待实测：社区版常见 `alipay`，也见过 `aliaqfpay`。
JEEPAY_TRANSFER_IF_CODE=alipay
JEEPAY_TRANSFER_ENTRY_TYPE=ALIPAY_CASH
# 付款支付宝授权控制服务；全部留空时不启用远程调用。
# 默认使用集中服务；本地模式按下方配置开启。
ALIPAY_AUTH_CONTROL_URL=
ALIPAY_AUTH_CONTROL_CLIENT_ID=
ALIPAY_AUTH_CONTROL_CREDENTIAL=
# 每个租户独立的 Fernet 数据密钥，须妥善备份并在发版后保持不变；丢失后无法解密已有记录。
ALIPAY_AUTH_DATA_KEY=
# 本地模式：每台工作室机器使用自己的密钥；代理账号由各服务器独立保管。
ALIPAY_AUTH_LOCAL_ENABLED=0
ONLINE_PAYROLL_ENABLED=0
ALIPAY_AGENT_USERNAME=
ALIPAY_AGENT_PASSWORD=
ALIPAY_AGENT_MERCHANT=
ALIPAY_AGENT_APP_NAME=
ALIPAY_AGENT_STATE_KEY=
ALIPAY_AGENT_TESSERACT=
ALIPAY_AGENT_LOCK_FILE=
# WITHDRAW_AUTO_TRANSFER：打手提现的「发起代付」开关，**默认 0（关）**。
#   关 = 审核页只有「通过 / 驳回 / 登记人工打款」（人工打款照常可用）。
#   ⚠️ 上线顺序：先 0 人工打款跑通一笔 → 0.1 元真单验一次代付 → 才改 1 并重启。
WITHDRAW_AUTO_TRANSFER=0
# WITHDRAW_TRANSFER_MAX_AMOUNT：单笔代付上限（元），业务方 2026-10-20 拍板 1000。
#   超过 ⇒ 代付端点直接拒（文案「超过代付单笔上限，请人工打款」）。
#   ⚠️ 写 0 表示「上限 0 元」（任何一笔都超限），**不是**「不设上限」。
WITHDRAW_TRANSFER_MAX_AMOUNT=1000
# WITHDRAW_PAYOUT_DELAY_MINUTES：审核通过后等多少**分钟**才自动代付（2026-10-21）。
#   默认 4320 = 3 天（业务方口径：审核通过后 3 天内自动打款）。业务方验收时设 1（一分钟）。
#   ⚠️ 写 0 = 审核通过即到期，**不是**「不自动付」；开关是 `WITHDRAW_AUTO_PAYOUT`（系统开关）。
WITHDRAW_PAYOUT_DELAY_MINUTES=4320
# WITHDRAW_REVIEW_TIMEOUT_HOURS：pending 超过多少小时没人处理 ⇒ 自动通过。
#   默认 24。
WITHDRAW_REVIEW_TIMEOUT_HOURS=24
# WITHDRAW_AUTO_REVIEW_SINCE：自动审核的**存量闸**（ISO 时间，带时区）。
#   ⚠️ **空 = 不自动审核**（默认）。上线时写部署当天，例 `2026-10-21T00:00:00+08:00`；
#   不设它会把上线前的历史 pending 单一次性全放行。
WITHDRAW_AUTO_REVIEW_SINCE=
# DEPOSIT_ENFORCED：押金闸总开关，**默认 0（关）**。
#   ⚠️ 打开 = 没冻够押金的打手**接不了单**（这正是押金模式的目的，但也可能一下子
#   把存量打手全挡住）⇒ 上线时逐租户显式打开并重启，漏开的症状是「押金规则配了但接单不拦」。
#   口径见 docs/RUNBOOK.md「打手 App / 押金上线」一节。
DEPOSIT_ENFORCED=0
# DEPOSIT_ENFORCED_APP：**只对打手 App（Bearer 令牌）生效**的押金闸，默认 0（关）。
#   与上面的总闸分开控制（业务方 2026-10-20）：打开后 App 接单要冻押金，网页端不受影响。
#   ⚠️ 本版 App 的充值通道还没接（只到"生成支付参数"），此时打开 = App 打手只能找客服充值。
#   上家镜像单的接单路径没有冻结逻辑 ⇒ 打开后 App **拒绝**接上家单（提示去网页端）。
DEPOSIT_ENFORCED_APP=0
# ── 在线客服（Chatwoot 网页小部件，2026-10-21）────────────────────────
# 打手 App / 小程序的「联系客服」打开后端拼好的承载页地址；四个键**任一为空**即整条链路
# 降级为「未开通」（接口回 200 + enabled=false，⛔ 不报错）。
#   ⚠️ CHATWOOT_HMAC_TOKEN 是**私密**密钥（只用于算 identifier_hash，⛔ 不回给客户端）。
#   ⚠️ CHATWOOT_WEBSITE_TOKEN 是公开值，承载页自己带着它，不进 URL。
# ⚠️ 占位值：每个租户**各自的** Chatwoot 实例 / 收件箱，⛔ 别照抄成别人的地址
#（identifier 里带租户 schema，但仍应一个租户一个收件箱）。
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_TOKEN=
CHATWOOT_PAGE_PATH=/app-chat.html

# ── 鸡蛋铺出站代理（2026-10-23）──────────────────────────────────────────
# 只给**鸡蛋铺的 httpx 客户端**用（登录式 + 官方 API 两条线）；留空 = 直连。
# 形如 http://user:pass@1.2.3.4:8080。⛔ 不要改成全局 HTTPS_PROXY：本机还要连 COS/支付/微信。
JIDANPU_PROXY=

# ── 鸡蛋铺图片下载超时（秒，2026-10-23）──────────────────────────────────
# **只管「把图片字节取回来」那一跳**（第三方图片直链，`jidanpu_upstream_pics.download_pic`）：
# 鸡蛋铺 SDK 的 30 秒超时管的是 JSON API 调用，这一跳是另一条链路 ⇒ 业务方要求单独一档。
# 默认 60；写坏（非整数 / ≤ 0）⇒ 回落 60 并在日志里记一条 warning。
JIDANPU_IMAGE_TIMEOUT=60

# ── 鸡蛋铺「读图列表」（ViewPic）超时（秒，2026-10-23）──────────────────
# 只影响 `GET /OrderAjax/ViewPic` 这一跳（「这张单有哪些图」的 JSON API）：默认 60，
# 且这一跳总共 2 次尝试（多给一次重试）。其它鸡蛋铺 API 仍是 30 秒。
# 写坏（非整数 / ≤ 0）⇒ 回落 60 并在日志里记一条 warning。
JIDANPU_VIEWPIC_TIMEOUT=60

# ── 鸡蛋铺：①式状态回拉覆盖「同一家店别的绑定」的开关（2026-10-25 兜底）──────────
# 对方关掉「开放平台接入权限」⇒ ②式（官方 API）取 token 被拒、回调一条都不到；
# 而**同一家店**的①式账号密码登录仍能读到批量状态。
# 1（**默认**）= ①式那一轮顺带覆盖同一 `jidanpu_base_url` 上**启用中**兄弟绑定（含②式）
#             的链路（按远端 orderId 匹配，照常写「待验收」；应用身份 = 那条链路自己的绑定）。
# 0 = 旧行为：只覆盖本绑定自己的链路。⛔ 停用的兄弟绑定两种取值下都不覆盖。
JIDANPU_MEMBER_PULL_COVERS_SIBLINGS=1

# ── 鸡蛋铺出站 IP 池（2026-10-25，`feat/egress-pool`）──────────────────────
# 出口列表（**顺序 = 优先级**，英文逗号分隔；`direct` / `local` / `直连` = 本机出口）。留空 = 直连。
# ⚠️ 密码里若带逗号必须先编码成 %2C（逗号是分隔符，否则会被切成两段）。
JIDANPU_PROXIES=
# 连续被对端 WAF 拦几次才换出口（政策值 3：单次可能是抖动，连续 3 次才当出口坏了）。
JIDANPU_EGRESS_FAIL_THRESHOLD=3
# 切走的出口隔离多久（秒；实测封禁 5–15 分钟 ⇒ 取上限 900）。全隔离时回落直连、同步不停摆。
JIDANPU_EGRESS_QUARANTINE_SECONDS=900
# 跨进程共享出口决策的状态文件（可选）：设了它，同一台机的多个常驻单元（上家/快路/回拉/outbox）
# 读写**同一份**当前出口与隔离表；留空 = 各进程各自决策（进程内状态）。
JIDANPU_EGRESS_STATE_FILE=

# ── 下家①式出向降频 / 每轮封顶 / 468 冷却（2026-10-27）─────────────────────
# 两条出向请求之间至少隔多少毫秒（默认 500；0 = 关闭降频）。
JIDANPU_MIN_REQUEST_INTERVAL_MS=500
# 一轮最多推多少条（默认 20）；第 K+1 条留到下一轮。
JIDANPU_OUTBOX_MAX_PER_ROUND=20
# 468 冷却基数（秒，默认 300 = 5 分钟）：池里出口全试完仍 468 ⇒ 该店冷却；
# 再被拦**翻倍**，封顶 30 分钟。冷却期只停这一家，其它店照常。
JIDANPU_OUTBOX_COOLDOWN_SECONDS=300

# 打手消息通知引导。填写目标工作室 schema 及官方关注链接或二维码图片地址；未指定工作室时不展示订阅入口。
WXPUSHER_SUBSCRIBE_TENANT_SCHEMA=
WXPUSHER_SUBSCRIBE_URL=
WXPUSHER_SUBSCRIBE_QR_URL=
# 应用发送密钥。只放运行环境或被忽略的 .env。
WXPUSHER_APP_TOKEN=
# 一键登录使用同一个 WxPusher 应用的数字 ID，并在「系统对接」配置独立验证密钥。
WXPUSHER_APP_ID=
WXPUSHER_LOGIN_SIGNING_KEY=

# 只绑定当前工作室的企微会话存档配置。旧可行部署未设置时沿用可行。
WECOM_ARCHIVE_TENANT_SCHEMA=
# 填写当前工作室授权的程序编号，留空时关闭功能。
WECOM_ARCHIVE_PROGRAM_ID=
# 各版本的 RSA 私钥文件放在目录下，例如 1.pem。用绝对路径，目录置于发版目录之外。
WECOM_ARCHIVE_PRIVATE_KEY_DIR=
# 消息展示索引最长保存天数，根据企微后台配置调整。
WECOM_ARCHIVE_RETENTION_DAYS=90
# JSON：团团通账号 ID 映射到企业微信成员 userid；空对象表示无人启用。
WECOM_ARCHIVE_VIEWERS={}
# 通过当前工作室的企微联调后按需开启，与会话存档开关独立。
WECOM_ZONE_ENABLED=False
# 当前工作室另行授权的自有模型与程序日志目标，逗号分隔。原程序包含在允许范围内。
WECOM_ZONE_LOG_TARGETS=
# 可行退款提醒试点。填实际规则 ID、群 ID 与带时区的启用时间，任一为空即关闭。
WECOM_REFUND_NOTICE_RULE_ID=
WECOM_REFUND_NOTICE_CHAT_ID=
WECOM_REFUND_NOTICE_START_AT=

# 暂停普通聊天请求；业务订单与签名导出/待办不受此门控制。
TT_CHAT_MAINTENANCE=false

# 启用访客注册和接待配置。先配置接待人员，再提供访客入口。
TT_INTERNAL_CHAT_VISITORS_ENABLED=false
